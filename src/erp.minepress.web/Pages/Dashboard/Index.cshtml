                            <div class="dash-hrms-icon bg-purple-lt"><i class="bi bi-clock-fill"></i></div>
                            <div class="dash-hrms-value" id="hrmsOvertime">—</div>
                            <div class="dash-hrms-label">OT This Month</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="dash-hrms-widget">
                            <div class="dash-hrms-icon bg-danger-lt"><i class="bi bi-heart-pulse"></i></div>
                            <div class="dash-hrms-value" id="hrmsMedical">—</div>
                            <div class="dash-hrms-label">Medical Claims</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="dash-hrms-widget">
                            <div class="dash-hrms-icon bg-teal-lt"><i class="bi bi-receipt-cutoff"></i></div>
                            <div class="dash-hrms-value" id="hrmsReimbursement">—</div>
                            <div class="dash-hrms-label">Reimbursements</div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="dash-hrms-detail-card">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-sun me-2 text-warning"></i>
                                <span class="fw-semibold small">Current Shift</span>
                            </div>
                            <div id="hrmsShiftInfo" class="small text-secondary">Loading...</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-hrms-detail-card">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-calendar-event me-2 text-success"></i>
                                <span class="fw-semibold small">Upcoming Holidays</span>
                            </div>
                            <div id="hrmsHolidays" class="small text-secondary">Loading...</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-hrms-detail-card">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-gift me-2 text-primary"></i>
                                <span class="fw-semibold small">Recent Incentives</span>
                            </div>
                            <div id="hrmsIncentives" class="small text-secondary">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ HRMS Overview (Top Management & Administration Only) ═══ -->
@if (Model.CanViewAllDepts)
{
<div class="row g-3 mb-3" id="hrmsOverviewSection">
    <div class="col-12">
        <div class="card dash-hrms-overview-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-people-fill me-2"></i>HRMS Organization Overview
                </h3>
                <div class="card-actions">
                    <span class="badge bg-primary-lt"><i class="bi bi-eye me-1"></i>Management View</span>
                </div>
            </div>
            <div class="card-body" id="hrmsOverviewPanel">
                <div class="row g-3">
                    <div class="col-6 col-md-3 col-lg">
                        <div class="dash-hrms-overview-stat">
                            <div class="dash-hrms-overview-icon bg-primary-lt"><i class="bi bi-people"></i></div>
                            <div class="dash-hrms-overview-value" id="ovTotalEmp">—</div>
                            <div class="dash-hrms-overview-label">Total Employees</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="dash-hrms-overview-stat">
                            <div class="dash-hrms-overview-icon bg-success-lt"><i class="bi bi-person-check"></i></div>
                            <div class="dash-hrms-overview-value" id="ovPresent">—</div>
                            <div class="dash-hrms-overview-label">Present Today</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="dash-hrms-overview-stat">
                            <div class="dash-hrms-overview-icon bg-danger-lt"><i class="bi bi-person-x"></i></div>
                            <div class="dash-hrms-overview-value" id="ovAbsent">—</div>
                            <div class="dash-hrms-overview-label">Absent Today</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
