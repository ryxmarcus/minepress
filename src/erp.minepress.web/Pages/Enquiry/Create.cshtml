@page
@model erp.minepress.web.Pages.Enquiry.CreateModel
@{
    ViewData["Title"] = "New Enquiry";
    ViewData["ContainerClass"] = "container-fluid";
    ViewData["HidePageHeader"] = true;
}

<!-- Compact Page Header -->
<div class="page-header d-print-none mb-3">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-md bg-primary-lt text-primary">
                    <i class="bi bi-clipboard-plus fs-3"></i>
                </span>
            </div>
            <div class="col">
                <h2 class="page-title mb-0">New Enquiry</h2>
                <div class="text-secondary mt-1">Configure rates, add items, and save your enquiry</div>
            </div>
            <div class="col-auto d-flex gap-2">
                <div id="enqGstBadge" class="d-none">
                    <span class="badge bg-teal-lt py-2 px-3" id="enqGstTypeBadge">
                        <i class="bi bi-shield-check me-1"></i><span id="enqGstTypeText">GST: Auto</span>
                    </span>
                </div>
                <a href="/Enquiry" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ── 3-Column Layout ── -->
<div class="enq-layout">

    <!-- ═══════ LEFT SIDEBAR ═══════ -->
    <aside class="enq-sidebar enq-sidebar-left">

        <!-- Customer Selection (shared component) -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-primary-lt text-primary"><i class="bi bi-people-fill"></i></span>
                    <h3 class="card-title mb-0">Customer</h3>
                </div>
            </div>
            <div class="card-body">
                <partial name="_CustomerSearchPartial" />
            </div>
        </div>

        <!-- Contact & Enquiry Info -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-azure-lt text-azure"><i class="bi bi-person-lines-fill"></i></span>
                    <h3 class="card-title mb-0">Contact &amp; Info</h3>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Contact Person</label>
                    <input type="text" id="txtContactPerson" class="form-control form-control-sm" placeholder="Full name" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Mobile</label>
                        <input type="text" id="txtContactMobile" class="form-control form-control-sm" placeholder="+91 ..." />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Email</label>
                        <input type="email" id="txtContactEmail" class="form-control form-control-sm" placeholder="email" />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Enquiry Source</label>
                        <select id="ddlEnquirySource" class="form-select form-select-sm">
                            <option value="">-- Select --</option>
                            <option value="WALK_IN">Walk-in</option>
                            <option value="PHONE">Phone</option>
                            <option value="EMAIL">Email</option>
                            <option value="WHATSAPP">WhatsApp</option>
                            <option value="WEBSITE">Website</option>
                            <option value="REFERRAL">Referral</option>
                            <option value="OTHER">Other</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Priority</label>
                        <select id="ddlPriority" class="form-select form-select-sm">
                            <option value="LOW">Low</option>
                            <option value="NORMAL" selected>Normal</option>
                            <option value="HIGH">High</option>
                            <option value="URGENT">Urgent</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Expected Delivery</label>
                    <input type="date" id="txtExpectedDelivery" class="form-control form-control-sm" />
                </div>
                <div>
                    <label class="form-label">Remarks</label>
                    <textarea id="txtRemarks" class="form-control form-control-sm" rows="2" placeholder="Any notes..."></textarea>
                </div>
            </div>
        </div>
    </aside>

    <!-- ═══════ CENTER: Estimate + Items ═══════ -->
    <main class="enq-main">
        <!-- Open Rate Calculator Drawer -->
        <button type="button" id="btnOpenEstimate" class="btn btn-orange w-100 py-3 enq-estimate-btn"
                data-bs-toggle="offcanvas" data-bs-target="#drawerRateCalc">
            <i class="bi bi-calculator-fill me-2 fs-4"></i>
            <span>
                <strong class="d-block">Open Rate Calculator</strong>
                <small class="opacity-75">Configure &amp; estimate pricing for items</small>
            </span>
        </button>

        <!-- Items List -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-green-lt text-green"><i class="bi bi-cart3"></i></span>
                    <h3 class="card-title mb-0">Enquiry Items</h3>
                    <span class="badge bg-primary-lt ms-auto" id="enqItemCount">0</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="enquiryItemsList" class="enq-items-list p-3">
                    <div class="empty py-4">
                        <div class="empty-icon"><i class="bi bi-calculator fs-1 text-secondary opacity-50"></i></div>
                        <p class="empty-title">No items added yet</p>
                        <p class="empty-subtitle text-secondary">Click <strong>"Open Rate Calculator"</strong> above to estimate and add items</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ═══════ RIGHT SIDEBAR: Summary ═══════ -->
    <aside class="enq-sidebar enq-sidebar-right">

        <!-- Summary Totals -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-yellow-lt text-yellow"><i class="bi bi-receipt-cutoff"></i></span>
                    <h3 class="card-title mb-0">Summary</h3>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-borderless m-0">
                    <tbody>
                        <tr>
                            <td class="text-secondary ps-3">Items</td>
                            <td class="text-end pe-3 fw-medium" id="enqSummaryItemCount">0</td>
                        </tr>
                        <tr>
                            <td class="text-secondary ps-3">Subtotal</td>
                            <td class="text-end pe-3 fw-medium" id="enqSubtotal">₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-secondary ps-3">Tax (GST)</td>
                            <td class="text-end pe-3 fw-medium" id="enqTotalTax">₹0.00</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <td class="ps-3 fw-bold">Grand Total</td>
                            <td class="text-end pe-3 fw-bold text-success fs-5" id="enqGrandTotal">₹0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Quick Info -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-cyan-lt text-cyan"><i class="bi bi-info-circle-fill"></i></span>
                    <h3 class="card-title mb-0">Quick Info</h3>
                </div>
            </div>
            <div class="card-body">
                <div id="enqQuickCustomer" class="text-secondary small mb-2">
                    <i class="bi bi-person me-1"></i>No customer selected
                </div>
                <div id="enqQuickPriority" class="text-secondary small mb-2">
                    <i class="bi bi-flag me-1"></i>Priority: Normal
                </div>
                <div id="enqQuickDelivery" class="text-secondary small">
                    <i class="bi bi-calendar-event me-1"></i>Delivery: Not set
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <button type="button" id="btnSaveEnquiry" class="btn btn-success w-100 py-2" disabled>
            <i class="bi bi-check-lg me-2"></i>Save Enquiry
        </button>
    </aside>
</div>

<!-- ═══════ OFFCANVAS: Rate Calculator Drawer (Right) ═══════ -->
<div class="offcanvas offcanvas-end enq-drawer" id="drawerRateCalc" tabindex="-1" aria-labelledby="drawerRateCalcLabel">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-sm bg-orange-lt text-orange"><i class="bi bi-calculator-fill"></i></span>
            <div>
                <h5 class="offcanvas-title mb-0" id="drawerRateCalcLabel">Rate Calculator</h5>
                <div class="small text-secondary">Configure rates and add items</div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body enq-drawer-body">
        <partial name="_RateCalculatorPartial" />
    </div>
    <div class="offcanvas-footer border-top p-3">
        <button type="button" id="btnAddItem" class="btn btn-primary w-100 py-2"
                data-bs-toggle="modal" data-bs-target="#aimModal">
            <i class="bi bi-plus-circle me-2"></i>Add Item to Enquiry
        </button>
    </div>
</div>

<partial name="_AddItemModalPartial" />

@section Scripts {
    <script src="/js/customer-search.js"></script>
    <script src="/js/hsn-sac-selector.js"></script>
    <script src="/js/add-item-modal.js"></script>
    <script src="/js/rate-calculator.js"></script>
    <script src="/js/save-progress.js"></script>
    <script src="/js/enquiry.js"></script>
    <script>
        // Capture full result for JSONB persistence
        if (typeof showResults === 'function') {
            const _origShowResults = showResults;
            showResults = function (res) {
                _origShowResults(res);
                window._lastCalcResult = res;
                window._lastCalcPartsData = typeof collectPartDetails === 'function'
                    ? collectPartDetails() : [];
            };
        }
    </script>
}
