@page "{id:long}"
@model erp.minepress.web.Pages.Maintenance.UserManagement.AssignAccessModel
@{
    ViewData["Title"] = "Assign Roles & Permissions";
    ViewData["ContainerClass"] = "container-xl";
    ViewData["HidePageHeader"] = true;
}

<!-- ── Page Header ── -->
<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-md bg-indigo-lt text-indigo fw-bold fs-4" id="aaAvatar">?</span>
        </div>
        <div class="col">
            <h2 class="page-title mb-0" id="aaHeroName">Loading…</h2>
            <div class="text-secondary mt-1 d-flex align-items-center gap-2 flex-wrap">
                <span id="aaHeroCode">—</span>
                <span id="aaHeroUsername">—</span>
                <span id="aaHeroStatus"></span>
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <a href="/Maintenance/UserManagement/Detail/@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Detail
            </a>
            <a href="/Maintenance/UserManagement" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-people me-1"></i>All Users
            </a>
        </div>
    </div>
</div>

<!-- ═══ AI Summary Bar ═══ -->
<div class="aa-ai-bar">
    <div class="aa-ai-icon"><i class="bi bi-stars"></i></div>
    <div class="flex-fill">
        <div class="fw-semibold small">Access Assignment Summary</div>
        <div id="aaAiHint" class="text-secondary" style="font-size:.78rem;">Loading access information…</div>
    </div>
    <div id="aaAiBadges" class="d-flex gap-2 flex-wrap"></div>
</div>

<!-- ═══ Action Bar ═══ -->
<div class="aa-action-bar">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="small text-secondary" id="aaChangeCount">No changes</span>
        <div class="ms-auto d-flex align-items-center gap-2">
            <span class="aa-last-saved text-secondary small" id="aaLastSaved"></span>
            <button class="btn btn-sm btn-outline-secondary" onclick="AaApp.resetChanges()">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
            </button>
            <button class="btn btn-sm btn-primary" id="aaSaveBtn" onclick="AaApp.saveAll()">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
        </div>
    </div>
</div>

<!-- ═══ Two-Panel Layout ═══ -->
<div class="row g-3">
    <!-- ── Roles Panel ── -->
    <div class="col-lg-5">
        <div class="card aa-panel">
            <div class="card-header aa-panel-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="aa-panel-icon"><i class="bi bi-shield"></i></div>
                    <div>
                        <h3 class="aa-panel-title mb-0">Roles</h3>
                        <div class="aa-panel-sub" id="aaRoleCount">0 roles available</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="AaApp.selectAllRoles()" title="Select All">
                        <i class="bi bi-check-all"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="AaApp.clearAllRoles()" title="Clear All">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="aa-search-wrap mb-2">
                    <i class="bi bi-search aa-search-icon"></i>
                    <input type="text" class="form-control form-control-sm aa-search" id="aaRoleSearch" placeholder="Search roles…" oninput="AaApp.filterRoles()" />
                </div>
                <div class="aa-role-grid" id="aaRoleGrid">
                    <div class="text-center text-secondary py-4"><i class="bi bi-hourglass-split me-1"></i>Loading roles…</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Permissions Panel ── -->
    <div class="col-lg-7">
        <div class="card aa-panel">
            <div class="card-header aa-panel-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="aa-panel-icon"><i class="bi bi-key"></i></div>
                    <div>
                        <h3 class="aa-panel-title mb-0">Permissions</h3>
                        <div class="aa-panel-sub" id="aaPermCount">0 permissions available</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="AaApp.selectAllPerms()" title="Select All">
                        <i class="bi bi-check-all"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="AaApp.clearAllPerms()" title="Clear All">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="aa-search-wrap mb-2">
                    <i class="bi bi-search aa-search-icon"></i>
                    <input type="text" class="form-control form-control-sm aa-search" id="aaPermSearch" placeholder="Search permissions…" oninput="AaApp.filterPerms()" />
                </div>
                <div id="aaPermGrid">
                    <div class="text-center text-secondary py-4"><i class="bi bi-hourglass-split me-1"></i>Loading permissions…</div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="aaUserId" value="@Model.Id" />

@section Styles {
    <link href="/css/assign-access.css" rel="stylesheet" />
}

@section Scripts {
    <script src="/js/assign-access.js"></script>
}
