{
  "version": "2.0",
  "system": "MinePress ERP",
  "description": "Comprehensive tool definitions for Multi-Agent Printing ERP — all modules",
  "modules": [
    {
      "module": "Job",
      "agent": "JobAgent",
      "tools": [
        {
          "name": "GetAllJobs",
          "description": "List all jobs with optional status filter. Use for 'show jobs', 'last job created', 'recent jobs', 'all jobs'",
          "parameters": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "description": "Filter by status code (e.g. created, in_progress, completed, cancelled)" },
              "limit": { "type": "integer", "description": "Max records to return (default 20)" }
            }
          }
        },
        {
          "name": "SearchJob",
          "description": "Search jobs by keyword (job number, customer name, product name)",
          "parameters": {
            "type": "object",
            "properties": {
              "keyword": { "type": "string", "description": "Search keyword" }
            },
            "required": ["keyword"]
          }
        },
        {
          "name": "GetJobDetails",
          "description": "Get detailed job information by job ID or job number",
          "parameters": {
            "type": "object",
            "properties": {
              "jobId": { "type": "string", "description": "Job ID or Job Number" }
            },
            "required": ["jobId"]
          }
        },
        {
          "name": "CreatePrintJob",
          "description": "Create a new printing job",
          "parameters": {
            "type": "object",
            "properties": {
              "customerName": { "type": "string", "description": "Customer name" },
              "jobType": { "type": "string", "description": "Printing type like Offset, Digital" },
              "productType": { "type": "string", "description": "Product like Brochure, Poster" },
              "quantity": { "type": "integer", "description": "Number of copies" },
              "paperSize": { "type": "string", "description": "Paper size like A4, A3" },
              "colorMode": { "type": "string", "description": "Color mode like Color or BW" }
            },
            "required": ["customerName", "jobType", "productType", "quantity"]
          }
        },
        {
          "name": "UpdatePrintJob",
          "description": "Update an existing print job (status, quantity, priority)",
          "parameters": {
            "type": "object",
            "properties": {
              "jobId": { "type": "string", "description": "Job ID or Job Number" },
              "status": { "type": "string", "description": "New status code" },
              "quantity": { "type": "integer", "description": "New quantity" },
              "priority": { "type": "string", "description": "New priority (Normal, High, Urgent)" }
            },
            "required": ["jobId"]
          }
        }
      ]
    },

