@page
@model erp.minepress.web.Pages.Hrms.Travel.IndexModel
@{
    ViewData["Title"] = "Travel Expenses — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-airplane" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Travel Expenses</h2>
            <div class="text-white-75">View and submit travel expense claims</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="Hrms.loadTravel()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <a href="/Hrms/Travel/Submit" class="btn btn-light">
                <i class="bi bi-plus-lg me-1"></i>New Expense
            </a>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-primary" id="trvTotalTrips">—</div>
                <div class="text-secondary small">Total Trips</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-warning" id="trvPendingCount">—</div>
                <div class="text-secondary small">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-info" id="trvClaimedAmount">—</div>
                <div class="text-secondary small">Total Claimed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-success" id="trvApprovedAmount">—</div>
                <div class="text-secondary small">Approved</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Travel No</th>
                    <th>Purpose</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Travel Date</th>
                    <th>Return Date</th>
                    <th>Claimed</th>
                    <th>Approved</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="travelTableBody">
                <tr>
                    <td colspan="9" class="text-center text-secondary py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Hrms.loadTravel());
    </script>
}
