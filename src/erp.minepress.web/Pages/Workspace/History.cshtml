@page
@model erp.minepress.web.Pages.Workspace.HistoryModel
@{
    ViewData["Title"] = "Activity History";
}

<!-- ═══ Hero Header ═══ -->
<div class="ws-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg ws-hero-avatar">
                <i class="bi bi-clock-history" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-1">Activity History</h2>
            <div class="text-white-75 d-flex align-items-center gap-2">
                <span class="badge bg-white text-dark">
                    <i class="bi bi-person-circle me-1"></i>@Model.UserFullName
                </span>
            </div>
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <a href="/Workspace" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Workspace
            </a>
            <button class="btn btn-outline-light btn-sm" onclick="Workspace.refreshHistory()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- ═══ Filter Bar ═══ -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body py-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <select class="form-select form-select-sm" id="historyDaysFilter" style="width:auto;">
                        <option value="7">Last 7 Days</option>
                        <option value="14">Last 14 Days</option>
                        <option value="30" selected>Last 30 Days</option>
                        <option value="90">Last 90 Days</option>
                    </select>
                    <div class="ms-auto">
                        <span class="text-secondary small" id="historyTotal"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Timeline ═══ -->
<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="wsHistoryTimeline">
                <div class="text-center py-5 text-secondary">
                    <div class="spinner-border spinner-border-sm me-2"></div>Loading history...
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center mt-3" id="historyPagination"></div>
    </div>
</div>

@section Styles {
    <link href="/css/workspace.css" rel="stylesheet" />
}

@section Scripts {
    <script src="/js/workspace.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Workspace.initHistory());
    </script>
}
