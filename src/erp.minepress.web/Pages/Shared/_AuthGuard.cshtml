@using erp.minepress.web.Helpers
@using erp.minepress.frameworks.Authentication
@{
    // Check both session-based and JWT-based authentication
    var sessionUser = Context.Session.GetObject<UserSessionData>("CurrentUser");
    var jwtUser = Context.GetJwtUser();
    
    var isAuthenticated = sessionUser != null || Context.IsJwtAuthenticated();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    
    // Define paths that don't require authentication
    var publicPaths = new[] { "/account/login", "/account/register", "/account/forgotpassword", "/display" };
    var isPublicPath = publicPaths.Any(p => currentPath.StartsWith(p));
}

@if (isAuthenticated || isPublicPath)
{
    @RenderBody()
}
else
{
    <script>
        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
    </script>
    <div class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Redirecting to login...</p>
        </div>
    </div>
}
