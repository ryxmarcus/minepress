@page
@model erp.minepress.web.Pages.Quotation.DetailsModel
@{
    ViewData["Title"] = Model.Mode == "create" ? "New Quotation" : "Quotation Details";
    ViewData["HidePageHeader"] = true;
}

<!-- ═══ CREATE MODE ═══ -->
@if (Model.Mode == "create")
{
<div class="page-header d-print-none mb-3">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-md bg-primary-lt text-primary">
                    <i class="bi bi-file-earmark-plus fs-3"></i>
                </span>
            </div>
            <div class="col">
                <h2 class="page-title mb-0" id="createPageTitle">New Quotation</h2>
                <div class="text-secondary mt-1" id="createPageSubtitle">Add items, set pricing, and save your quotation</div>
            </div>
            <div class="col-auto">
                <a href="/Quotation" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-xl">
    <!-- Customer Selection -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar avatar-xs bg-primary-lt text-primary"><i class="bi bi-people-fill"></i></span>
                        <h3 class="card-title mb-0">Customer</h3>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_CustomerSearchPartial" />
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar avatar-xs bg-azure-lt text-azure"><i class="bi bi-info-circle-fill"></i></span>
                        <h3 class="card-title mb-0">Quotation Info</h3>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Party Reference No</label>
                            <input type="text" id="txtPartyRefNo" class="form-control form-control-sm" placeholder="Customer PO / Ref" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Valid Till</label>
                            <input type="date" id="txtValidTill" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Terms &amp; Conditions</label>
                        <textarea id="txtTerms" class="form-control form-control-sm" rows="3" placeholder="Enter terms and conditions..."></textarea>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Remarks</label>
                        <textarea id="txtRemarks" class="form-control form-control-sm" rows="2" placeholder="Additional notes..."></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Items -->
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-teal-lt text-teal"><i class="bi bi-list-ul"></i></span>
                    <h3 class="card-title mb-0">Items</h3>
                    <span class="badge bg-primary ms-1" id="createItemCount">0</span>
                </div>
                <button class="btn btn-primary btn-sm" id="btnAddItem" onclick="addItemRow()">
                    <i class="bi bi-plus-lg me-1"></i>Add Item
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-vcenter card-table mb-0" id="itemsTable">
                    <thead>
                        <tr>
                            <th style="width:30px;">#</th>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th style="width:70px;" class="text-center">Qty</th>
                            <th style="width:100px;" class="text-end">Unit Rate</th>
                            <th style="width:100px;" class="text-end">Gross Amt</th>
                            <th style="width:70px;" class="text-end">Disc %</th>
                            <th style="width:70px;" class="text-end">CGST %</th>
                            <th style="width:70px;" class="text-end">SGST %</th>
                            <th style="width:100px;" class="text-end">Tax Amt</th>
                            <th style="width:110px;" class="text-end">Net Amt</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr id="noItemsRow">
                            <td colspan="12" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size:2rem;opacity:.3;"></i>
                                <div class="mt-2">No items added yet. Click "Add Item" to begin.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Totals & Save -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6"></div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td class="text-muted">Subtotal</td>
                            <td class="text-end fw-semibold" id="sumTotal">₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Discount</td>
                            <td class="text-end fw-semibold text-danger" id="sumDiscount">₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Taxable Amount</td>
                            <td class="text-end fw-semibold" id="sumTaxable">₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Tax</td>
                            <td class="text-end fw-semibold" id="sumTax">₹0.00</td>
                        </tr>
                        <tr class="border-top">
                            <td class="fw-bold fs-4">Net Amount</td>
                            <td class="text-end fw-bold fs-3 text-primary" id="sumNet">₹0.00</td>
                        </tr>
                    </table>
                    <div class="mt-3 d-flex gap-2 justify-content-end">
                        <a href="/Quotation" class="btn btn-outline-secondary">Cancel</a>
                        <button class="btn btn-primary" id="btnSaveQuotation" onclick="saveQuotation()">
                            <i class="bi bi-check-lg me-1"></i>Save Quotation
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
<!-- ═══ VIEW MODE ═══ -->

<!-- Loading Spinner -->
<div id="detailsLoader" class="text-center py-5">
    <div class="spinner-border text-primary" role="status"></div>
    <div class="text-muted mt-2">Loading quotation details...</div>
</div>

<!-- Error State -->
<div id="detailsError" class="text-center py-5" style="display:none;">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size:3rem;"></i>
    <div class="text-muted mt-2" id="errorMessage">Failed to load quotation.</div>
    <a href="/Quotation" class="btn btn-primary mt-3"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<!-- Main Content -->
<div id="detailsContent" style="display:none;">

    <!-- Header Bar -->
    <div class="qt-detail-hero d-print-none">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <a href="/Quotation" class="btn btn-ghost-light btn-sm rounded-circle" title="Back to list">
                    <i class="bi bi-arrow-left fs-5"></i>
                </a>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 class="mb-0 text-white" id="hdQuotationNo"></h2>
                        <span class="qt-status-badge qt-status-pill" id="hdStatus"></span>
                    </div>
                    <div class="text-white-50 small mt-1">
                        <i class="bi bi-calendar3 me-1"></i><span id="hdDate"></span>
                        <span class="mx-2">·</span>
                        <i class="bi bi-person me-1"></i><span id="hdCreatedBy"></span>
                        <span class="mx-2" id="hdEnquiryLink"></span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-success btn-sm" id="btnEmailCustomer" onclick="QuotationDetails.sendEmail()">
                    <i class="bi bi-envelope me-1"></i>Email to Customer
                </button>
                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-gear me-1"></i>Actions
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" href="javascript:void(0)" id="btnSendQuotation">
                            <i class="bi bi-send me-2 text-info"></i>Mark as Sent
                        </a>
                        <a class="dropdown-item" href="javascript:void(0)" id="btnApproveQuotation">
                            <i class="bi bi-check-circle me-2 text-success"></i>Mark Approved
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="javascript:void(0)" id="btnCancelQuotation">
                            <i class="bi bi-x-circle me-2 text-warning"></i>Cancel
                        </a>
                        <a class="dropdown-item" href="javascript:void(0)" id="btnCloseQuotation">
                            <i class="bi bi-lock me-2 text-secondary"></i>Close
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs qt-detail-tabs d-print-none" id="detailTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button">
                <i class="bi bi-info-circle me-1"></i>Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-items" data-bs-toggle="tab" data-bs-target="#pane-items" type="button">
                <i class="bi bi-list-ul me-1"></i>Items <span class="badge bg-primary ms-1" id="tabItemCount">0</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-timeline" data-bs-toggle="tab" data-bs-target="#pane-timeline" type="button">
                <i class="bi bi-clock-history me-1"></i>Timeline
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-activities" data-bs-toggle="tab" data-bs-target="#pane-activities" type="button">
                <i class="bi bi-stars me-1"></i>Customer 360°
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content mt-3" id="detailTabContent">

        <!-- Overview Pane -->
        <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">
            <div class="row g-3">
                <!-- Customer Card -->
                <div class="col-lg-4">
                    <div class="card qt-detail-card h-100">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-person-circle me-2 text-primary"></i>Customer</h3>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="avatar avatar-lg rounded-circle qt-detail-avatar" id="custAvatar"></span>
                                <div>
                                    <div class="fw-bold fs-4" id="custName"></div>
                                    <div class="text-muted small" id="custCode"></div>
                                </div>
                            </div>
                            <div class="qt-detail-info-list">
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-receipt text-muted"></i>
                                    <span class="text-muted">GST No</span>
                                    <strong id="custGst">-</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-envelope text-muted"></i>
                                    <span class="text-muted">Email</span>
                                    <strong id="custEmail">-</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-geo-alt text-muted"></i>
                                    <span class="text-muted">Address</span>
                                    <strong id="custAddress">-</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quotation Info -->
                <div class="col-lg-4">
                    <div class="card qt-detail-card h-100">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-file-earmark-text me-2 text-info"></i>Quotation Info</h3>
                        </div>
                        <div class="card-body">
                            <div class="qt-detail-info-list">
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-calendar-event text-muted"></i>
                                    <span class="text-muted">Valid Till</span>
                                    <strong id="qtValidTill">-</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-link-45deg text-muted"></i>
                                    <span class="text-muted">Party Ref</span>
                                    <strong id="qtPartyRef">-</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-clipboard-data text-muted"></i>
                                    <span class="text-muted">Enquiry</span>
                                    <strong id="qtEnquiry">-</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-hash text-muted"></i>
                                    <span class="text-muted">Total Items</span>
                                    <strong id="qtItemCount">0</strong>
                                </div>
                            </div>
                            <div class="mt-3 p-2 rounded" style="background:var(--tblr-bg-surface-secondary);">
                                <div class="small text-muted mb-1"><i class="bi bi-chat-left-text me-1"></i>Remarks</div>
                                <div class="small" id="qtRemarks"><em class="text-muted">No remarks</em></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Financial Summary -->
                <div class="col-lg-4">
                    <div class="card qt-detail-card h-100">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-currency-rupee me-2 text-success"></i>Financial Summary</h3>
                        </div>
                        <div class="card-body">
                            <div class="qt-detail-info-list">
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-calculator text-muted"></i>
                                    <span class="text-muted">Subtotal</span>
                                    <strong id="qtTotalAmount">₹0.00</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-tag text-muted"></i>
                                    <span class="text-muted">Discount</span>
                                    <strong id="qtDiscountAmount" class="text-danger">₹0.00</strong>
                                </div>
                                <div class="qt-detail-info-item">
                                    <i class="bi bi-percent text-muted"></i>
                                    <span class="text-muted">Tax</span>
                                    <strong id="qtTaxAmount">₹0.00</strong>
                                </div>
                            </div>
                            <div class="mt-3 p-3 rounded text-center" style="background:linear-gradient(135deg,var(--tblr-primary-bg-subtle),var(--tblr-azure-bg-subtle));">
                                <div class="text-primary small fw-semibold text-uppercase">Net Amount</div>
                                <div class="fs-1 fw-bold text-primary" id="qtNetAmount">₹0.00</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terms & Conditions -->
            <div class="card mt-3" id="termsCard" style="display:none;">
                <div class="card-header">
                    <h3 class="card-title"><i class="bi bi-journal-text me-2 text-orange"></i>Terms &amp; Conditions</h3>
                </div>
                <div class="card-body">
                    <div id="qtTerms" class="small" style="white-space:pre-line;"></div>
                </div>
            </div>
        </div>

        <!-- Items Pane -->
        <div class="tab-pane fade" id="pane-items" role="tabpanel">
            <div id="itemsContainer"></div>
        </div>

        <!-- Timeline Pane -->
        <div class="tab-pane fade" id="pane-timeline" role="tabpanel">
            <div id="timelineContainer">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2"></div>Loading timeline...
                </div>
            </div>
        </div>

        <!-- Customer Activities Pane -->
        <div class="tab-pane fade" id="pane-activities" role="tabpanel">
            <div id="customerActivityContainer">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="mt-2">Loading customer activity dashboard...</div>
                </div>
            </div>
        </div>

    </div>
</div>
}

@section Scripts {
    <script src="/js/customer-search.js"></script>
    <script src="/js/customer-activity.js"></script>
    <script src="/js/quotation-details.js"></script>
    <script>
        $(document).ready(function () {
            const mode = '@(Model.Mode ?? "")';
            const id = @Model.Id;
            const fromEnquiryId = @(Model.FromEnquiryId.HasValue ? Model.FromEnquiryId.Value.ToString() : "0");

            if (mode === 'create') {
                QuotationCreate.init(fromEnquiryId > 0 ? fromEnquiryId : null);
            } else if (id > 0) {
                QuotationDetails.load(id);
            } else {
                $('#detailsLoader').hide();
                $('#detailsError').show();
                $('#errorMessage').text('Invalid quotation ID.');
            }
        });
    </script>
}
