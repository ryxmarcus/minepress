@page
@model erp.minepress.web.Pages.Hrms.Travel.SubmitModel
@{
    ViewData["Title"] = "Submit Travel Expense — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-airplane" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Submit Travel Expense</h2>
            <div class="text-white-75">File a new travel expense claim</div>
        </div>
        <div class="col-auto">
            <a href="/Hrms/Travel" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Travel
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Travel Expense Form</h3>
            </div>
            <div class="card-body">
                <form id="travelExpenseForm">
                    <div class="mb-3">
                        <label class="form-label required">Purpose of Travel</label>
                        <input type="text" class="form-control" id="trvPurpose" placeholder="e.g. Client meeting, Site visit" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">From Location</label>
                            <input type="text" class="form-control" id="trvFromLocation" placeholder="Departure city/location" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">To Location</label>
                            <input type="text" class="form-control" id="trvToLocation" placeholder="Destination city/location" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label required">Travel Date</label>
                            <input type="date" class="form-control" id="trvTravelDate" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Return Date</label>
                            <input type="date" class="form-control" id="trvReturnDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Claim Amount (₹)</label>
                            <input type="number" class="form-control" id="trvClaimAmount" min="1" step="100" placeholder="e.g. 5000" required />
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit Expense
                        </button>
                        <a href="/Hrms/Travel" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-info-circle me-1"></i>Guidelines</h3>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>Submit claims within 7 days of return from travel.</li>
                    <li>Attach original tickets and receipts at the HR office.</li>
                    <li>Per diem, lodging, and conveyance are covered as per company policy.</li>
                    <li>Pre-approved travel requires prior manager authorization.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('travelExpenseForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const payload = {
                    purpose: document.getElementById('trvPurpose').value,
                    fromLocation: document.getElementById('trvFromLocation').value,
                    toLocation: document.getElementById('trvToLocation').value,
                    travelDate: document.getElementById('trvTravelDate').value,
                    returnDate: document.getElementById('trvReturnDate').value || null,
                    claimAmount: parseFloat(document.getElementById('trvClaimAmount').value)
                };

                const res = await Hrms.post('travel/submit', payload);
                if (res) {
                    Swal.fire({ icon: 'success', title: 'Expense Submitted', text: res.message, timer: 2000 });
                    setTimeout(() => window.location.href = '/Hrms/Travel', 2000);
                }
            });
        });
    </script>
}
