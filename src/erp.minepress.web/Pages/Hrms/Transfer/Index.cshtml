@page
@model erp.minepress.web.Pages.Hrms.Transfer.IndexModel
@{
    ViewData["Title"] = "Transfers — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-arrow-left-right" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Transfers</h2>
            <div class="text-white-75">View your transfer history and current status</div>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-light btn-sm" onclick="Hrms.loadTransfers()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Transfer No</th>
                    <th>Transfer Date</th>
                    <th>From Dept</th>
                    <th>To Dept</th>
                    <th>Reason</th>
                    <th>Effective Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="transferTableBody">
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Hrms.loadTransfers());
    </script>
}
