                        <div class="dash-hrms-overview-stat">
                            <div class="dash-hrms-overview-icon bg-purple-lt"><i class="bi bi-hourglass"></i></div>
                            <div class="dash-hrms-overview-value" id="ovPendingLeave">—</div>
                            <div class="dash-hrms-overview-label">Pending Leaves</div>
                        </div>
                    </div>
                </div>
                <hr class="my-3" />
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg">
                        <div class="dash-hrms-mini-stat">
                            <i class="bi bi-bank text-info me-2"></i>
                            <div>
                                <div class="fw-bold" id="ovActiveLoans">—</div>
                                <div class="text-secondary" style="font-size:.7rem;">Active Loans</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="dash-hrms-mini-stat">
                            <i class="bi bi-cash text-azure me-2"></i>
                            <div>
                                <div class="fw-bold" id="ovPendingAdv">—</div>
                                <div class="text-secondary" style="font-size:.7rem;">Pending Advances</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="dash-hrms-mini-stat">
                            <i class="bi bi-clock text-warning me-2"></i>
                            <div>
                                <div class="fw-bold" id="ovPendingOT">—</div>
                                <div class="text-secondary" style="font-size:.7rem;">Pending Overtime</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
