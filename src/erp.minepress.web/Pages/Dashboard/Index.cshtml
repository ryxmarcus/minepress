                                <div class="text-secondary" style="font-size:.7rem;">Pending Medical</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="dash-hrms-mini-stat">
                            <i class="bi bi-door-open text-purple me-2"></i>
                            <div>
                                <div class="fw-bold" id="ovPendingResign">—</div>
                                <div class="text-secondary" style="font-size:.7rem;">Resignations</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="dash-hrms-mini-stat">
