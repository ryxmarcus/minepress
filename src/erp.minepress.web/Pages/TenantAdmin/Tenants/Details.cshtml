@page "{tenantId:guid}"
@model erp.minepress.web.Pages.TenantAdmin.Tenants.DetailsModel
@{
    ViewData["Title"] = "Tenant Details";
}

@if (Model.Tenant == null)
{
    <div class="alert alert-warning">Tenant not found.</div>
    <a class="btn btn-secondary" href="/TenantAdmin/Tenants">Back</a>
    return;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.GeneratedApiKey))
{
    <div class="alert alert-warning">
        <strong>Copy API key now:</strong>
        <code>@Model.GeneratedApiKey</code>
    </div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Update Tenant Details - @Model.Tenant.Name (@Model.Tenant.TenantKey)</h3>
        <a class="btn btn-outline-secondary btn-sm" href="/TenantAdmin/Tenants">Back to list</a>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Update">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="UpdateRequest.Name" class="form-label"></label>
                    <input asp-for="UpdateRequest.Name" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="UpdateRequest.SubscriptionPlan" class="form-label"></label>
                    <input asp-for="UpdateRequest.SubscriptionPlan" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="UpdateRequest.MaxUsers" class="form-label"></label>
                    <input asp-for="UpdateRequest.MaxUsers" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="UpdateRequest.SubscriptionExpiresAt" class="form-label"></label>
                    <input asp-for="UpdateRequest.SubscriptionExpiresAt" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-4 form-check mt-4 ms-2">
                    <input asp-for="UpdateRequest.IsActive" class="form-check-input" />
                    <label asp-for="UpdateRequest.IsActive" class="form-check-label">Tenant Active</label>
                </div>
                <div class="col-md-4 form-check mt-4 ms-2">
                    <input asp-for="UpdateRequest.EnableIpRestriction" class="form-check-input" />
                    <label asp-for="UpdateRequest.EnableIpRestriction" class="form-check-label">Enable IP Restriction</label>
                </div>
                <div class="col-md-3 form-check mt-4 ms-2">
                    <input asp-for="UpdateRequest.RequireTwoFactor" class="form-check-input" />
                    <label asp-for="UpdateRequest.RequireTwoFactor" class="form-check-label">Require 2FA</label>
                </div>
                <div class="col-md-2">
                    <label asp-for="UpdateRequest.DataRetentionDays" class="form-label"></label>
                    <input asp-for="UpdateRequest.DataRetentionDays" class="form-control" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Update Tenant Details</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">Database Connections</h4>
            </div>
            <div class="card-body border-bottom">
                <form method="post" asp-page-handler="AddConnection" class="row g-2">
                    <div class="col-md-3">
                        <input asp-for="NewConnection.ConnectionType" class="form-control form-control-sm" placeholder="secondary" />
                    </div>
                    <div class="col-md-5">
                        <input asp-for="NewConnection.ConnectionString" class="form-control form-control-sm" placeholder="Connection string" />
                    </div>
                    <div class="col-md-2">
                        <input asp-for="NewConnection.Priority" class="form-control form-control-sm" placeholder="Priority" />
                    </div>
                    <div class="col-md-2 d-flex align-items-center gap-2">
                        <input asp-for="NewConnection.IsActive" class="form-check-input" />
                        <button type="submit" class="btn btn-sm btn-primary">Add</button>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-sm card-table">
                    <thead><tr><th>Type</th><th>Priority</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Connections)
                    {
                        <tr>
                            <td>@item.ConnectionType</td>
                            <td>@item.Priority</td>
                            <td>@(item.IsActive ? "Active" : "Inactive")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h4 class="card-title mb-0">Feature Flags</h4></div>
            <div class="card-body border-bottom">
                <form method="post" asp-page-handler="AddFeature" class="row g-2">
                    <div class="col-md-4">
                        <input asp-for="NewFeature.FeatureName" class="form-control form-control-sm" placeholder="Feature name" />
                    </div>
                    <div class="col-md-5">
                        <input asp-for="NewFeature.ConfigurationJson" class="form-control form-control-sm" placeholder='{"enabledFor":"all"}' />
                    </div>
                    <div class="col-md-1 d-flex align-items-center">
                        <input asp-for="NewFeature.IsEnabled" class="form-check-input" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-sm card-table">
                    <thead><tr><th>Feature</th><th>Status</th><th>Config</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Features)
                    {
                        <tr>
                            <td>@item.FeatureName</td>
                            <td>@(item.IsEnabled ? "Enabled" : "Disabled")</td>
                            <td><code>@item.Configuration</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">API Keys & Tokens</h4>
        <form method="post" asp-page-handler="IssueApiKey" class="d-flex gap-2">
            <input asp-for="ApiScopesJson" class="form-control form-control-sm" style="min-width:260px;" placeholder='["read","write"]' />
            <button type="submit" class="btn btn-success btn-sm">Issue API Key</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-sm card-table">
            <thead>
                <tr><th>Prefix</th><th>Scopes</th><th>Expires</th><th>Last Used</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var key in Model.ApiCredentials)
            {
                <tr>
                    <td><code>@key.KeyPrefix</code></td>
                    <td><code>@key.Scopes</code></td>
                    <td>@key.ExpiresAt.ToString("dd-MMM-yyyy")</td>
                    <td>@(key.LastUsedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                    <td>@(key.IsActive ? "Active" : "Revoked")</td>
                    <td class="text-end">
                        @if (key.IsActive)
                        {
                            <form method="post" asp-page-handler="RevokeApiKey" class="d-inline">
                                <input type="hidden" name="credentialId" value="@key.Id" />
                                <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header"><h4 class="card-title mb-0">Security Events</h4></div>
    <div class="table-responsive">
        <table class="table table-sm card-table">
            <thead><tr><th>Time</th><th>Type</th><th>Severity</th><th>Description</th><th>Source IP</th></tr></thead>
            <tbody>
            @foreach (var evt in Model.SecurityEvents)
            {
                <tr>
                    <td>@evt.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</td>
                    <td>@evt.EventType</td>
                    <td>@evt.Severity</td>
                    <td>@evt.Description</td>
                    <td>@(evt.SourceIp ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
