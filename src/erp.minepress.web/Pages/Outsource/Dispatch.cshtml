@page
@model erp.minepress.web.Pages.Outsource.DispatchModel
@{
    ViewData["Title"] = "Record Dispatch";
}

<div class="os-detail-hero d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-send" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0" id="heroTitle">Record Material Dispatch</h2>
            <div class="text-white-75" id="heroSub"></div>
        </div>
        <div class="col-auto d-flex gap-2">
            <a id="btnBack" href="/Outsource" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Details</a>
        </div>
    </div>
</div>

<!-- Status Banner -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="os-status-badge os-status-pill" id="statusBadge">Loading…</span>
            </div>
            <div class="col" id="headerInfo"></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- ═══ Left Column: Outsource Summary ═══ -->
    <div class="col-lg-5">
        <!-- Order Info -->
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-info-circle me-2 text-purple"></i>Outsource Order</h3></div>
            <div class="card-body" id="orderInfo">
                <div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm me-2"></div>Loading…</div>
            </div>
        </div>

        <!-- Vendor Info -->
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-building me-2 text-purple"></i>Vendor</h3></div>
            <div class="card-body" id="vendorInfo"></div>
        </div>

        <!-- Items Reference -->
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-list-check me-2 text-purple"></i>Order Items</h3></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-sm">
                    <thead>
                        <tr><th>#</th><th>Product</th><th>Process</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr><td colspan="5" class="text-center text-muted py-3">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ═══ Right Column: Dispatch Form + History ═══ -->
    <div class="col-lg-7">
        <!-- Dispatch Form -->
        <div class="card mb-3 border-purple">
            <div class="card-header bg-purple-lt">
                <h3 class="card-title"><i class="bi bi-send me-2 text-purple"></i>New Dispatch</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label required">Challan No</label>
                        <input type="text" class="form-control" id="dChallanNo" placeholder="Enter challan / DC number" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label required">Total Quantity</label>
                        <input type="number" class="form-control" id="dTotalQty" min="0" step="0.01" placeholder="Dispatch quantity" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Remarks</label>
                        <textarea class="form-control" id="dRemarks" rows="3" placeholder="Any dispatch notes, transport details…"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkEmailVendor" checked>
                    <label class="form-check-label" for="chkEmailVendor">
                        <i class="bi bi-envelope me-1"></i>Email dispatch notice to vendor
                    </label>
                </div>
                <button class="btn btn-purple" id="btnSaveDispatch" onclick="saveDispatch()">
                    <i class="bi bi-check-lg me-1"></i>Save Dispatch
                </button>
            </div>
        </div>

        <!-- Dispatch History -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-clock-history me-2 text-azure"></i>Previous Dispatches</h3>
                <span class="badge bg-azure-lt ms-auto" id="dispatchCount">0</span>
            </div>
            <div class="card-body" id="dispatchHistory">
                <div class="text-muted text-center py-3">Loading…</div>
            </div>
        </div>

        <!-- Recent Timeline -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-activity me-2 text-secondary"></i>Recent Timeline</h3>
            </div>
            <div class="card-body" id="recentTimeline" style="max-height:300px;overflow-y:auto;">
                <div class="text-muted text-center py-3">Loading…</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const OS_API = '/api/outsource';
    const outsourceId = @Model.Id;
    let osData = null;

    $(function () { loadDetail(); });

    async function loadDetail() {
        try {
            osData = await $.get(`${OS_API}/detail/${outsourceId}`);
            renderPage();
        } catch (err) {
            Swal2.error(err.responseJSON?.message || 'Failed to load outsource details.');
        }
    }

    function renderPage() {
        const d = osData;

        // Hero
        $('#heroTitle').text(`Record Dispatch — ${d.outsourceNo}`);
        $('#heroSub').text(`${d.vendorName} • ${d.processType || 'General'} • ${d.outsourceDate}`);
        $('#btnBack').attr('href', `/Outsource/Details?id=${d.outsourceId}`);

        // Status
        const sc = getStatusClass(d.status);
        $('#statusBadge').attr('class', `os-status-badge os-status-pill ${sc}`).text(fmtStatus(d.status));
        $('#headerInfo').html(`
            <div class="row small">
                <div class="col-auto"><span class="os-info-label">Job:</span> <a href="/Job/Details?id=${d.jobId}">${d.jobNo}</a></div>
                <div class="col-auto"><span class="os-info-label">Customer:</span> ${d.customerName || '—'}</div>
                <div class="col-auto"><span class="os-info-label">Total Qty:</span> <strong>${d.totalQuantity ?? '—'}</strong></div>
                <div class="col-auto"><span class="os-info-label">Amount:</span> <strong>₹${(d.totalAmount ?? 0).toLocaleString('en-IN', {minimumFractionDigits:2})}</strong></div>
            </div>
        `);

        // Order info
        $('#orderInfo').html(`
            <div class="row g-2">
                ${ic('Outsource No', d.outsourceNo)}${ic('Date', d.outsourceDate)}
                ${ic('Process Type', d.processType || '—')}${ic('Expected Delivery', d.expectedDeliveryDate || '—')}
                ${ic('Status', `<span class="os-status-badge ${sc}">${fmtStatus(d.status)}</span>`)}
                ${ic('Remarks', d.remarks || '—')}
            </div>
        `);

        // Vendor info
        $('#vendorInfo').html(`
            <div class="row g-2">
                ${ic('Name', d.vendorName)}${ic('Code', d.vendorCode || '—')}
                ${ic('Email', d.vendorEmail || '—')}${ic('GST', d.vendorGst || '—')}
            </div>
        `);

        // Items
        const items = d.items || [];
        if (items.length) {
            let ih = '';
            items.forEach((item, i) => {
                ih += `<tr>
                    <td>${i + 1}</td>
                    <td class="fw-semibold">${item.productName || '—'}</td>
                    <td>${item.processName || '—'}</td>
                    <td class="text-end">${item.quantity ?? 0}</td>
                    <td class="text-end">₹${(item.amount ?? 0).toLocaleString('en-IN', {minimumFractionDigits:2})}</td>
                </tr>`;
            });
            $('#itemsBody').html(ih);
        } else {
            $('#itemsBody').html('<tr><td colspan="5" class="text-center text-muted py-3">No items.</td></tr>');
        }

        // Pre-fill total qty suggestion
        const dispatched = (d.dispatches || []).reduce((s, x) => s + (x.totalQuantity ?? 0), 0);
        const remaining = (d.totalQuantity ?? 0) - dispatched;
        if (remaining > 0) $('#dTotalQty').attr('placeholder', `Remaining: ${remaining}`);

        // Disable email checkbox if no vendor email
        if (!d.vendorEmail) {
            $('#chkEmailVendor').prop('checked', false).prop('disabled', true);
            $('#chkEmailVendor').closest('.form-check').find('label').append(' <small class="text-muted">(no email)</small>');
        }

        // Dispatches
        renderDispatches(d.dispatches || []);

        // Timeline (recent 10)
        renderTimeline((d.timeline || []).slice(0, 10));
    }

    function renderDispatches(dispatches) {
        $('#dispatchCount').text(dispatches.length);
        if (!dispatches.length) {
            $('#dispatchHistory').html('<div class="text-muted text-center py-3">No previous dispatches.</div>');
            return;
        }
        let html = '';
        dispatches.forEach(d => {
            html += `<div class="card card-sm mb-2 os-dispatch-card">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong><i class="bi bi-send me-2 text-purple"></i>${d.challanNo || 'No Challan'}</strong>
                            <span class="ms-3 text-muted small">${d.dispatchDate}</span>
                        </div>
                        <div class="fw-bold">Qty: ${d.totalQuantity ?? '—'}</div>
                    </div>
                    ${d.remarks ? `<div class="small text-muted mt-1">${d.remarks}</div>` : ''}
                </div>
            </div>`;
        });
        $('#dispatchHistory').html(html);
    }

    function renderTimeline(timeline) {
        if (!timeline.length) { $('#recentTimeline').html('<div class="text-muted text-center py-3">No timeline events.</div>'); return; }
        let html = '<div class="os-timeline">';
        timeline.forEach(t => {
            html += `<div class="os-timeline-entry">
                <div class="os-timeline-dot ${getTlDot(t.eventType)}"></div>
                <div class="d-flex justify-content-between">
                    <strong class="small">${t.eventTitle}</strong>
                    <span class="small text-muted">${t.createdOn}</span>
                </div>
                ${t.eventDescription ? `<div class="small text-muted">${t.eventDescription}</div>` : ''}
            </div>`;
        });
        html += '</div>';
        $('#recentTimeline').html(html);
    }

    // ── Save Dispatch ──
    async function saveDispatch() {
        const challanNo = $('#dChallanNo').val()?.trim();
        const totalQty = parseFloat($('#dTotalQty').val()) || 0;

        if (!challanNo) { Swal2.error('Please enter a Challan / DC number.'); return; }
        if (totalQty <= 0) { Swal2.error('Quantity must be greater than zero.'); return; }

        try {
            Swal2.showLoading('Recording dispatch…');
            const res = await $.ajax({
                url: `${OS_API}/dispatch`, method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    outsourceId,
                    challanNo,
                    totalQuantity: totalQty,
                    remarks: $('#dRemarks').val()?.trim() || null
                })
            });
            Swal2.hideLoading();

            // Email to vendor if checked
            if ($('#chkEmailVendor').is(':checked') && osData?.vendorEmail) {
                try {
                    Swal2.showLoading('Sending dispatch email to vendor…');
                    await $.ajax({
                        url: `${OS_API}/send-email-vendor`, method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ outsourceId })
                    });
                    Swal2.hideLoading();
                } catch (emailErr) {
                    Swal2.hideLoading();
                    console.warn('Email to vendor failed', emailErr);
                }
            }

            await Swal.fire({
                icon: 'success',
                title: 'Dispatch Recorded!',
                html: `Challan <strong>${challanNo}</strong> — Qty: <strong>${totalQty}</strong> dispatched successfully.`,
                showCancelButton: true,
                confirmButtonText: 'View Details',
                cancelButtonText: 'Record Another',
                confirmButtonColor: '#6f42c1'
            }).then(result => {
                if (result.isConfirmed) {
                    window.location.href = `/Outsource/Details?id=${outsourceId}`;
                } else {
                    // Reset form and reload
                    $('#dChallanNo').val('');
                    $('#dTotalQty').val('');
                    $('#dRemarks').val('');
                    loadDetail();
                }
            });
        } catch (err) {
            Swal2.hideLoading();
            Swal2.error(err.responseJSON?.message || 'Failed to save dispatch.');
        }
    }

    // ── Helpers ──
    function ic(label, val) { return `<div class="col-md-6"><div class="os-info-label">${label}</div><div class="os-info-value">${val}</div></div>`; }
    function fmtStatus(s) { return s ? s.replace(/_/g, ' ') : 'N/A'; }
    function getStatusClass(status) {
        const m = {
            'OUTSOURCE_CREATED':'os-status-created','VENDOR_ASSIGNED':'os-status-vendor_assigned',
            'MATERIAL_SENT':'os-status-material_sent','VENDOR_ACKNOWLEDGED':'os-status-vendor_ack',
            'PROCESS_STARTED':'os-status-process_started','PROCESS_COMPLETED':'os-status-process_done',
            'QUALITY_CHECKED':'os-status-quality','MATERIAL_RECEIVED':'os-status-received',
            'RETURN_DELAYED':'os-status-delayed','REWORK_REQUIRED':'os-status-rework',
            'REWORK_SENT':'os-status-rework','REWORK_COMPLETED':'os-status-quality',
            'PAYMENT_INITIATED':'os-status-payment','PAYMENT_COMPLETED':'os-status-payment',
            'OUTSOURCE_CLOSED':'os-status-closed','OUTSOURCE_CANCELLED':'os-status-cancelled'
        };
        return m[status] || 'bg-secondary-lt';
    }
    function getTlDot(et) {
        const m = {
            'OUTSOURCE_CREATED':'dot-purple','VENDOR_ASSIGNED':'dot-info','MATERIAL_SENT':'dot-info',
            'VENDOR_ACKNOWLEDGED':'dot-cyan','PROCESS_STARTED':'dot-cyan','PROCESS_COMPLETED':'dot-info',
            'QUALITY_CHECKED':'dot-success','MATERIAL_RECEIVED':'dot-success','RETURN_DELAYED':'dot-warning',
            'REWORK_REQUIRED':'dot-orange','REWORK_SENT':'dot-orange','REWORK_COMPLETED':'dot-success',
            'PAYMENT_INITIATED':'dot-warning','PAYMENT_COMPLETED':'dot-success',
            'OUTSOURCE_CLOSED':'dot-primary','OUTSOURCE_CANCELLED':'dot-danger'
        };
        return m[et] || 'dot-primary';
    }
</script>
}
