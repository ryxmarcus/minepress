@page
@model erp.minepress.web.Pages.GatePass.IndexModel
@{
    ViewData["Title"] = "Gate Passes";
}

<!-- Hero Header -->
<div class="ch-hero d-print-none" style="background: linear-gradient(135deg, #198754, #20c997);">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-shield-check" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Gate Passes</h2>
            <div class="text-white-75">Track inward and outward gate passes.</div>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-light btn-sm" onclick="loadGpList()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-success-lt me-3"><i class="bi bi-shield-check"></i></span>
                    <div><div class="fw-bold fs-3" id="gpStatTotal">0</div><div class="text-secondary small">Total</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-info-lt me-3"><i class="bi bi-clock"></i></span>
                    <div><div class="fw-bold fs-3" id="gpStatIssued">0</div><div class="text-secondary small">Issued</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-primary-lt me-3"><i class="bi bi-check-circle"></i></span>
                    <div><div class="fw-bold fs-3" id="gpStatApproved">0</div><div class="text-secondary small">Approved</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-green-lt me-3"><i class="bi bi-check-all"></i></span>
                    <div><div class="fw-bold fs-3" id="gpStatCompleted">0</div><div class="text-secondary small">Completed</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                    <input type="text" id="gpSearch" class="form-control form-control-sm" placeholder="Search gate pass no, vehicle, reference..." />
                </div>
            </div>
            <div class="col-md-2">
                <select id="gpTypeFilter" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="OUTWARD">Outward</option>
                    <option value="INWARD">Inward</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="gpStatusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="ISSUED">Issued</option>
                    <option value="APPROVED">Approved</option>
                    <option value="COMPLETED">Completed</option>
                    <option value="CANCELLED">Cancelled</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Gate Pass Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table ch-list-table table-hover">
            <thead>
                <tr>
                    <th>Gate Pass No</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Vehicle</th>
                    <th>Driver</th>
                    <th class="text-center">Items</th>
                    <th class="text-end">Total Qty</th>
                    <th>Status</th>
                    <th class="text-center" style="width:80px;">Actions</th>
                </tr>
            </thead>
            <tbody id="gpListBody">
                <tr><td colspan="10" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const GP_API = '/api/gatepass';
        let allGatePasses = [];

        $(document).ready(function () {
            loadGpList();
            $('#gpSearch, #gpTypeFilter, #gpStatusFilter').on('input change', applyFilters);
        });

        function loadGpList() {
            $('#gpListBody').html('<tr><td colspan="10" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>');
            $.get(`${GP_API}/list`, function (data) {
                allGatePasses = data;
                updateStats();
                applyFilters();
            }).fail(function () {
                $('#gpListBody').html('<tr><td colspan="10" class="text-center text-danger py-3"><i class="bi bi-exclamation-circle me-1"></i>Failed to load gate passes.</td></tr>');
            });
        }

        function updateStats() {
            $('#gpStatTotal').text(allGatePasses.length);
            $('#gpStatIssued').text(allGatePasses.filter(g => g.status === 'ISSUED').length);
            $('#gpStatApproved').text(allGatePasses.filter(g => g.status === 'APPROVED').length);
            $('#gpStatCompleted').text(allGatePasses.filter(g => g.status === 'COMPLETED').length);
        }

        function applyFilters() {
            const q = ($('#gpSearch').val() || '').toLowerCase();
            const gpType = $('#gpTypeFilter').val();
            const gpStatus = $('#gpStatusFilter').val();
            const filtered = allGatePasses.filter(g => {
                if (q && !(g.gatePassNo || '').toLowerCase().includes(q) &&
                    !(g.vehicleNo || '').toLowerCase().includes(q) &&
                    !(g.referenceNo || '').toLowerCase().includes(q)) return false;
                if (gpType && g.gatepassType !== gpType) return false;
                if (gpStatus && g.status !== gpStatus) return false;
                return true;
            });
            renderTable(filtered);
        }

        function renderTable(data) {
            if (!data.length) {
                $('#gpListBody').html('<tr><td colspan="10" class="text-center text-muted py-4"><i class="bi bi-shield" style="font-size:2rem; opacity:.3;"></i><div class="mt-2">No gate passes found</div></td></tr>');
                return;
            }
            let html = '';
            data.forEach(g => {
                const statusBadge = g.status === 'ISSUED' ? 'bg-info-lt' : g.status === 'APPROVED' ? 'bg-success-lt' : g.status === 'COMPLETED' ? 'bg-green-lt' : g.status === 'CANCELLED' ? 'bg-danger-lt' : 'bg-secondary-lt';
                const typeBadge = g.gatepassType === 'OUTWARD' ? 'bg-azure-lt' : 'bg-teal-lt';
                html += `<tr>
                    <td><a href="/GatePass/Details?id=${g.gatePassId}" class="fw-semibold text-decoration-none">${esc(g.gatePassNo)}</a><div class="text-muted small">${g.createdOn || ''}</div></td>
                    <td>${esc(g.gatePassDate)}</td>
                    <td><span class="badge ${typeBadge}">${esc(g.gatepassType || '—')}</span></td>
                    <td>${g.referenceNo ? `<span class="badge bg-purple-lt">${esc(g.referenceNo)}</span>` : '—'}<div class="text-muted small">${esc(g.referenceType || '')}</div></td>
                    <td>${esc(g.vehicleNo || '—')}</td>
                    <td><div class="small">${esc(g.driverName || '—')}</div><div class="text-muted small">${esc(g.driverContact || '')}</div></td>
                    <td class="text-center"><span class="badge bg-primary-lt">${g.itemCount}</span></td>
                    <td class="text-end fw-semibold">${g.totalQuantity != null ? Number(g.totalQuantity).toLocaleString('en-IN') : '—'}</td>
                    <td><span class="badge ${statusBadge}">${esc(g.status || '—')}</span></td>
                    <td class="text-center">
                        <a href="/GatePass/Details?id=${g.gatePassId}" class="btn btn-ghost-primary btn-sm btn-icon" title="View"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>`;
            });
            $('#gpListBody').html(html);
        }

        function esc(v) { return (v || '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;'); }
    </script>
}
