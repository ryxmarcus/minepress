<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - MinePress ERP</title>
    <meta name="msapplication-TileColor" content="#066fd1" />
    <meta name="theme-color" content="#066fd1" />
    <!-- MinePress (Tabler) core CSS - includes Bootstrap 5 -->
    <link href="/dist/css/minepress.min.css" rel="stylesheet" />
    <link href="/dist/css/minepress-vendors.min.css" rel="stylesheet" />
    <link href="/dist/css/minepress-themes.min.css" rel="stylesheet" />
    <!-- Select2 CSS + Bootstrap 5 theme -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons (used by rate-calculator) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- App CSS -->
   
    <link href="/css/rate-calculator.css" rel="stylesheet" />
    <link href="/css/enquiry.css" rel="stylesheet" />
    <link href="/css/notification-bell.css" rel="stylesheet" />
    <link href="/css/quotation.css" rel="stylesheet" />
    <link href="/css/job.css" rel="stylesheet" />
    <link href="/css/customer-activity.css" rel="stylesheet" />
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/hrms.css" rel="stylesheet" />
    <link href="/css/challan.css" rel="stylesheet" />
    <link href="/css/outsource.css" rel="stylesheet" />
    <link href="/css/accounting.css" rel="stylesheet" />
    <link href="/css/store.css" rel="stylesheet" />
    <link href="/css/item-picker.css" rel="stylesheet" />
    <link href="/css/supplier-picker.css" rel="stylesheet" />
    <link href="/css/job-picker.css" rel="stylesheet" />
    <link href="/css/stock-summary.css" rel="stylesheet" />
    <link href="/css/production.css" rel="stylesheet" />
    <link href="/css/agentic-ai.css" rel="stylesheet" />
    <link href="/css/report-builder.css" rel="stylesheet" />
    <link href="/css/db-manager.css" rel="stylesheet" />
    <link href="/css/party-management.css" rel="stylesheet" />
    <link href="/css/user-management.css" rel="stylesheet" />
    <link href="/css/user-profile.css" rel="stylesheet" />
    <link href="/css/item-management.css" rel="stylesheet" />
    <link href="/css/user-create.css" rel="stylesheet" />
    <link href="/css/user-detail.css" rel="stylesheet" />
    <link href="/css/item-create.css" rel="stylesheet" />
    <link href="/css/workspace.css" rel="stylesheet" />
    <link href="/css/workflow.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <script src="/dist/js/minepress-theme.min.js"></script>
    <script>
        /** MinePress Theme Toggle - persists to localStorage, applies data-bs-theme on <html> */
        const MpTheme = {
            key: 'minepress-theme',
            get current() {
                return localStorage.getItem(this.key) || 'light';
            },
            apply(theme) {
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-bs-theme');
                }
                localStorage.setItem(this.key, theme);
            },
            toggle() {
                this.apply(this.current === 'dark' ? 'light' : 'dark');
            },
            init() {
                this.apply(this.current);
            }
        };
        MpTheme.init();
    </script>
    
    @using erp.minepress.frameworks.Authentication
    @{
        var sessionUser = Context.Session.GetObject<erp.minepress.web.Helpers.UserSessionData>("CurrentUser");
        var tenantAdminUser = Context.Session.GetObject<erp.minepress.web.Helpers.TenantAdminSessionData>("TenantAdminUser");
        var jwtUser = Context.GetJwtUser();
        var isAuthenticated = sessionUser != null || tenantAdminUser != null || Context.IsJwtAuthenticated();
        var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        var publicPaths = new[] { "/account/login", "/account/register", "/account/forgotpassword", "/display", "/tenantadmin/account/login" };
        var isPublicPath = publicPaths.Any(p => currentPath.StartsWith(p));
    }
    
    <!-- AuthGuard: Protects authenticated content -->
    @if (isAuthenticated || isPublicPath)
    {
        <div class="page">
            <!-- DynamicNavbar Component -->
            @await Html.PartialAsync("_DynamicNavbar")
            
            <!-- Page wrapper -->
            <div class="page-wrapper">
                <div class="page-body">
                    <div class="@(ViewData["ContainerClass"] as string ?? "container-xl")">
                        @RenderBody()
                    </div>
                </div>
                
                <!-- PageFooter Component -->
                @await Html.PartialAsync("_PageFooter")
            </div>
        </div>
    }
    else
    {
        <script>
            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
        </script>
        <div class="d-flex align-items-center justify-content-center min-vh-100">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Redirecting to login...</p>
            </div>
        </div>
    }

    <!-- jQuery (required by Select2 and app scripts) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <!-- Select2 (requires jQuery) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- MinePress (Tabler) core JS - includes Bootstrap 5 internally -->
    <script src="/dist/js/minepress.min.js"></script>
    <!-- Expose Bootstrap global from Tabler bundle -->
    <script>if(window.minepress&&window.minepress.bootstrap)window.bootstrap=window.minepress.bootstrap;</script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/swal-helpers.js"></script>
    <script src="/js/notification-bell.js"></script>
    <script src="/js/navbar-punch.js"></script>
    <!-- Real-Time Toast Alerts -->
    <script src="/js/toast-alerts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
