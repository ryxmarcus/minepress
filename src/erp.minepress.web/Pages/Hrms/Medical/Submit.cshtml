@page
@model erp.minepress.web.Pages.Hrms.Medical.SubmitModel
@{
    ViewData["Title"] = "Submit Medical Claim — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-heart-pulse" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Submit Medical Claim</h2>
            <div class="text-white-75">File a new medical reimbursement claim</div>
        </div>
        <div class="col-auto">
            <a href="/Hrms/Medical" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Claims
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Medical Claim Form</h3>
            </div>
            <div class="card-body">
                <form id="medicalClaimForm">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Claim Date</label>
                            <input type="date" class="form-control" id="medClaimDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Claim Amount (₹)</label>
                            <input type="number" class="form-control" id="medClaimAmount" min="1" step="100" placeholder="e.g. 5000" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Patient Name</label>
                            <input type="text" class="form-control" id="medPatientName" placeholder="Patient's full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Relation</label>
                            <select class="form-select" id="medRelation">
                                <option value="Self">Self</option>
                                <option value="Spouse">Spouse</option>
                                <option value="Child">Child</option>
                                <option value="Parent">Parent</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hospital / Clinic Name</label>
                        <input type="text" class="form-control" id="medHospitalName" placeholder="Enter hospital or clinic name" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit Claim
                        </button>
                        <a href="/Hrms/Medical" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-info-circle me-1"></i>Guidelines</h3>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>Claims must be submitted within 30 days of treatment.</li>
                    <li>Attach original bills/receipts at the HR office.</li>
                    <li>Coverage includes self, spouse, children, and dependent parents.</li>
                    <li>Maximum claim limit is as per company medical policy.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('medicalClaimForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const payload = {
                    claimDate: document.getElementById('medClaimDate').value,
                    patientName: document.getElementById('medPatientName').value,
                    relation: document.getElementById('medRelation').value,
                    hospitalName: document.getElementById('medHospitalName').value,
                    claimAmount: parseFloat(document.getElementById('medClaimAmount').value)
                };

                const res = await Hrms.post('medical/submit', payload);
                if (res) {
                    Swal.fire({ icon: 'success', title: 'Claim Submitted', text: res.message, timer: 2000 });
                    setTimeout(() => window.location.href = '/Hrms/Medical', 2000);
                }
            });
        });
    </script>
}
