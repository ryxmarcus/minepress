@page
@model erp.minepress.web.Pages.Quotation.CreateModel
@{
    ViewData["Title"] = "New Quotation";
    ViewData["ContainerClass"] = "container-fluid";
    ViewData["HidePageHeader"] = true;
}

<!-- Compact Page Header -->
<div class="page-header d-print-none mb-3">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="avatar avatar-md bg-green-lt text-green">
                    <i class="bi bi-file-earmark-plus fs-3"></i>
                </span>
            </div>
            <div class="col">
                <h2 class="page-title mb-0" id="qtCreateTitle">New Quotation</h2>
                <div class="text-secondary mt-1" id="qtCreateSubtitle">Configure rates, add items, and save your quotation</div>
            </div>
            <div class="col-auto d-flex gap-2">
                <div id="qtGstBadge" class="d-none">
                    <span class="badge bg-teal-lt py-2 px-3" id="qtGstTypeBadge">
                        <i class="bi bi-shield-check me-1"></i><span id="qtGstTypeText">GST: Auto</span>
                    </span>
                </div>
                <a href="/Quotation" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ── 3-Column Layout ── -->
<div class="qt-create-layout">

    <!-- ═══════ LEFT SIDEBAR ═══════ -->
    <aside class="qt-create-sidebar qt-create-sidebar-left">

        <!-- Customer Selection (shared component) -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-green-lt text-green"><i class="bi bi-people-fill"></i></span>
                    <h3 class="card-title mb-0">Customer</h3>
                </div>
            </div>
            <div class="card-body">
                <partial name="_CustomerSearchPartial" />
            </div>
        </div>

        <!-- Quotation Info -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-azure-lt text-azure"><i class="bi bi-file-earmark-text"></i></span>
                    <h3 class="card-title mb-0">Quotation Info</h3>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Party Ref No</label>
                        <input type="text" id="txtPartyRefNo" class="form-control form-control-sm" placeholder="Customer PO / Ref" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Valid Till</label>
                        <input type="date" id="txtValidTill" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Terms &amp; Conditions</label>
                    <textarea id="txtTerms" class="form-control form-control-sm" rows="3" placeholder="Payment, delivery terms..."></textarea>
                </div>
                <div>
                    <label class="form-label">Remarks</label>
                    <textarea id="txtRemarks" class="form-control form-control-sm" rows="2" placeholder="Any notes..."></textarea>
                </div>
            </div>
        </div>
    </aside>

    <!-- ═══════ CENTER: Estimate + Items ═══════ -->
    <main class="qt-create-main">
        <!-- Open Rate Calculator Drawer -->
        <button type="button" id="btnOpenEstimate" class="btn w-100 py-3 qt-estimate-btn"
                data-bs-toggle="offcanvas" data-bs-target="#drawerQtRateCalc">
            <i class="bi bi-calculator-fill me-2 fs-4"></i>
            <span>
                <strong class="d-block">Open Rate Calculator</strong>
                <small class="opacity-75">Configure &amp; estimate pricing for items</small>
            </span>
        </button>

        <!-- Items List -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-teal-lt text-teal"><i class="bi bi-cart3"></i></span>
                    <h3 class="card-title mb-0">Quotation Items</h3>
                    <span class="badge bg-green-lt ms-auto" id="qtItemCount">0</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="qtItemsList" class="qt-items-list p-3">
                    <div class="empty py-4">
                        <div class="empty-icon"><i class="bi bi-calculator fs-1 text-secondary opacity-50"></i></div>
                        <p class="empty-title">No items added yet</p>
                        <p class="empty-subtitle text-secondary">Click <strong>"Open Rate Calculator"</strong> above to estimate and add items</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ═══════ RIGHT SIDEBAR: Summary ═══════ -->
    <aside class="qt-create-sidebar qt-create-sidebar-right">

        <!-- Summary Totals -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-yellow-lt text-yellow"><i class="bi bi-receipt-cutoff"></i></span>
                    <h3 class="card-title mb-0">Summary</h3>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-borderless m-0">
                    <tbody>
                        <tr>
                            <td class="text-secondary ps-3">Items</td>
                            <td class="text-end pe-3 fw-medium" id="qtSummaryItemCount">0</td>
                        </tr>
                        <tr>
                            <td class="text-secondary ps-3">Subtotal</td>
                            <td class="text-end pe-3 fw-medium" id="qtSubtotal">₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-secondary ps-3">Discount</td>
                            <td class="text-end pe-3 fw-medium text-danger" id="qtDiscount">-₹0.00</td>
                        </tr>
                        <tr>
                            <td class="text-secondary ps-3">Taxable</td>
                            <td class="text-end pe-3 fw-medium" id="qtTaxable">₹0.00</td>
                        </tr>
                        <tr id="qtCgstRow">
                            <td class="text-secondary ps-3">CGST</td>
                            <td class="text-end pe-3 fw-medium" id="qtCgst">₹0.00</td>
                        </tr>
                        <tr id="qtSgstRow">
                            <td class="text-secondary ps-3">SGST</td>
                            <td class="text-end pe-3 fw-medium" id="qtSgst">₹0.00</td>
                        </tr>
                        <tr id="qtIgstRow" style="display:none;">
                            <td class="text-secondary ps-3">IGST</td>
                            <td class="text-end pe-3 fw-medium" id="qtIgst">₹0.00</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <td class="ps-3 fw-bold">Net Amount</td>
                            <td class="text-end pe-3 fw-bold text-success fs-5" id="qtGrandTotal">₹0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Quick Info -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-xs bg-cyan-lt text-cyan"><i class="bi bi-info-circle-fill"></i></span>
                    <h3 class="card-title mb-0">Quick Info</h3>
                </div>
            </div>
            <div class="card-body">
                <div id="qtQuickCustomer" class="text-secondary small mb-2">
                    <i class="bi bi-person me-1"></i>No customer selected
                </div>
                <div id="qtQuickGst" class="text-secondary small mb-2">
                    <i class="bi bi-shield me-1"></i>GST: Auto-detect
                </div>
                <div id="qtQuickValidTill" class="text-secondary small mb-2">
                    <i class="bi bi-calendar-event me-1"></i>Valid till: Not set
                </div>
                <div id="qtQuickSource" class="text-secondary small">
                    <i class="bi bi-link-45deg me-1"></i>Source: Direct
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <button type="button" id="btnSaveQuotation" class="btn btn-success w-100 py-2" disabled>
            <i class="bi bi-check-lg me-2"></i>Save Quotation
        </button>
    </aside>
</div>

<!-- ═══════ OFFCANVAS: Rate Calculator Drawer (Right) ═══════ -->
<div class="offcanvas offcanvas-end qt-drawer" id="drawerQtRateCalc" tabindex="-1" aria-labelledby="drawerQtRateCalcLabel">
    <div class="offcanvas-header border-bottom">
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-sm bg-orange-lt text-orange"><i class="bi bi-calculator-fill"></i></span>
            <div>
                <h5 class="offcanvas-title mb-0" id="drawerQtRateCalcLabel">Rate Calculator</h5>
                <div class="small text-secondary">Configure rates and add items</div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body qt-drawer-body">
        <partial name="_RateCalculatorPartial" />
    </div>
    <div class="offcanvas-footer border-top p-3">
        <button type="button" id="btnQtAddItem" class="btn btn-primary w-100 py-2"
                data-bs-toggle="modal" data-bs-target="#aimModal">
            <i class="bi bi-plus-circle me-2"></i>Add Item to Quotation
        </button>
    </div>
</div>

<partial name="_AddItemModalPartial" />

@section Scripts {
    <script src="/js/customer-search.js"></script>
    <script src="/js/hsn-sac-selector.js"></script>
    <script src="/js/add-item-modal.js"></script>
    <script src="/js/rate-calculator.js"></script>
    <script src="/js/save-progress.js"></script>
    <script src="/js/quotation-create.js"></script>
    <script>
        // Capture full result for JSONB persistence
        if (typeof showResults === 'function') {
            const _origShowResults = showResults;
            showResults = function (res) {
                _origShowResults(res);
                window._lastCalcResult = res;
                window._lastCalcPartsData = typeof collectPartDetails === 'function'
                    ? collectPartDetails() : [];
            };
        }

        $(document).ready(function () {
            const fromEnquiryId = @(Model.FromEnquiryId.HasValue ? Model.FromEnquiryId.Value.ToString() : "0");
            QtCreate.init(fromEnquiryId > 0 ? fromEnquiryId : null);
        });
    </script>
}
