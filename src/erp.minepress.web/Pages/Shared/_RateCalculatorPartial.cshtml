@* Reusable Rate Calculator Component — embeddable in Enquiry, Quotation, Job pages *@

<div id="rateCalculatorWidget">
    <!-- STEP 1: Job Configuration -->
    <div class="card rc-section rc-section-blue mb-3 rc-animate-in">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number">1</span>
                <div>
                    <h4 class="m-0">Job Configuration</h4>
                    <div class="text-secondary small">Select the type of job to configure workflow</div>
                </div>
                <span class="badge bg-primary-lt ms-auto"><i class="bi bi-lightning-charge-fill me-1"></i>Required</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label required">Job Type</label>
                    <select id="ddlJobType" class="form-select select2">
                        <option value="">-- Select Job Type --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Product Type</label>
                    <select id="ddlProductType" class="form-select select2">
                        <option value="">-- Select --</option>
                    </select>
                </div>
            </div>
            <input type="hidden" id="txtPrintingMode" />
            <div id="jobTypeFlags" class="mt-3 d-none">
                <div class="d-flex flex-wrap gap-2" id="flagBadges"></div>
            </div>
            <div id="workflowBar" class="mt-3 d-none">
                <label class="form-label text-secondary">Workflow</label>
                <div id="workflowSteps"></div>
            </div>
            <div id="dynamicFieldsInfo" class="mt-3 d-none">
                <div class="alert alert-info py-2 mb-0">
                    <div class="d-flex">
                        <div><i class="bi bi-info-circle me-2"></i></div>
                        <div id="requiredFieldsText"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STEP 2: Product & Quantity -->
    <div class="card rc-section rc-section-azure mb-3 rc-animate-in">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-azure">2</span>
                <div>
                    <h4 class="m-0">Product Details</h4>
                    <div class="text-secondary small">Choose product type, size, and quantity</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Product Size</label>
                    <select id="ddlProductSize" class="form-select select2">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label required">Quantity</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="bi bi-hash"></i></span>
                        <input id="txtQuantity" type="number" class="form-control" min="1" value="500" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trim W (mm)</label>
                    <input id="txtTrimWidth" type="number" class="form-control" step="0.1" value="210" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trim H (mm)</label>
                    <input id="txtTrimHeight" type="number" class="form-control" step="0.1" value="297" />
                </div>
            </div>
            <div class="row g-3 mt-1" id="partsContainer" style="display:none;">
                <div class="col-12">
                    <div class="parts-toolbar">
                        <div class="parts-toolbar-title">
                            <i class="bi bi-layers me-2 text-primary"></i>
                            <span class="fw-semibold">Product Parts</span>
                        </div>
                        <div class="parts-toolbar-controls">
                            <div class="parts-toolbar-field">
                                <label class="parts-toolbar-label" for="txtTotalPages">Pages</label>
                                <input id="txtTotalPages" type="number" class="form-control form-control-sm" style="width:72px;" min="2" step="2" value="2" />
                            </div>
                            <div class="parts-toolbar-field">
                                <label class="parts-toolbar-label" for="ddlSides">Sides</label>
                                <select id="ddlSides" class="form-select form-select-sm" style="width:100px;">
                                    <option value="1">Single</option>
                                    <option value="2" selected>Both</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAutoDistributeParts">
                                <i class="bi bi-magic me-1"></i><span class="d-none d-sm-inline">AI Divide</span><span class="d-sm-none">AI</span>
                            </button>
                        </div>
                    </div>
                    <div id="partsList" class="mt-0"></div>
                    <div class="parts-hint">
                        <i class="bi bi-info-circle me-1"></i>Pages &amp; colors per part. <strong>AI Divide</strong> splits total pages across active parts.
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkCustomerMaterial" />
                        <span class="form-check-label">Customer Material</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Design / DTP + CTP / Plates (merged) -->
    <div class="card rc-section rc-section-purple mb-3 rc-animate-in" id="secDesign" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-purple"><i class="bi bi-palette-fill"></i></span>
                <div>
                    <h4 class="m-0">Design / DTP & CTP</h4>
                    <div class="text-secondary small">Designing services and plate selection</div>
                </div>
                <span class="badge bg-purple-lt ms-auto"><i class="bi bi-robot me-1"></i>AI Assisted</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6" id="secDesignCol">
                    <label class="form-label">Designing Services</label>
                    <select id="ddlDesigning" class="form-select select2" multiple="multiple">
                    </select>
                </div>
                <div class="col-md-6" id="secPlate" style="display:none;">
                    <label class="form-label">Plate</label>
                    <select id="ddlPlate" class="form-select select2">
                        <option value="">-- Select Plate --</option>
                    </select>
                    <div id="plateAiInfo" class="d-none mt-1">
                        <span class="badge bg-azure-lt">
                            <i class="bi bi-robot me-1"></i>Auto-selected cheapest plate
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden auto-selected fields -->
    <div style="display:none;">
        <select id="ddlInks" multiple="multiple"></select>
        <select id="ddlColors"><option value="4" selected>4</option></select>
        <select id="ddlPaper"><option value=""></option></select>
    </div>

    <!-- Printing -->
    <div class="card rc-section rc-section-orange mb-3 rc-animate-in" id="secPrinting" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-orange"><i class="bi bi-printer-fill"></i></span>
                <div>
                    <h4 class="m-0">Printing</h4>
                    <div class="text-secondary small">Machine and ink selection for printing</div>
                </div>
                <span class="badge bg-orange-lt ms-auto"><i class="bi bi-robot me-1"></i>AI Assisted</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Machine</label>
                    <select id="ddlMachine" class="form-select select2">
                        <option value="">-- Select Machine --</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div id="machineAiInfo" class="d-none">
                        <span class="badge bg-azure-lt">
                            <i class="bi bi-robot me-1"></i>Auto-selected best machine
                        </span>
                    </div>
                </div>
            </div>

            <!-- Print-Only Parameters (PRINT_OFFSET / PRINT_DIGITAL / PRINT_SCREEN / PRINT_FLEX / PRINT_UV) -->
            <div id="secPrintOnlyFields" style="display:none;">
                <hr class="my-3" />
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-sliders me-2 text-orange"></i>
                    <span class="fw-semibold text-secondary small text-uppercase" style="letter-spacing:.05em;">Print-Only Parameters</span>
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label required">Print Size</label>
                        <select id="ddlPrintSize" class="form-select select2">
                            <option value="">-- Select Size --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label required">Printing Side</label>
                        <select id="ddlPrintSide" class="form-select">
                            <option value="1">Single Side</option>
                            <option value="2">Double Side</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label required">No. of Colors</label>
                        <select id="ddlPrintColors" class="form-select">
                            <option value="1">1 Color</option>
                            <option value="2">2 Colors</option>
                            <option value="3">3 Colors</option>
                            <option value="4" selected>4 Colors (CMYK)</option>
                            <option value="5">5 Colors</option>
                            <option value="6">6 Colors</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Plates Received</label>
                        <div class="input-icon">
                            <span class="input-icon-addon"><i class="bi bi-grid-3x3-gap"></i></span>
                            <input id="txtPlatesReceived" type="number" class="form-control" min="0" value="0" placeholder="Plates from customer" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Binding + Finishing (merged) -->
    <div class="card rc-section rc-section-cyan mb-3 rc-animate-in" id="secBinding" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-cyan"><i class="bi bi-book-fill"></i></span>
                <div>
                    <h4 class="m-0">Binding & Finishing</h4>
                    <div class="text-secondary small">Binding type and optional finishing processes</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6" id="secBindingCol">
                    <label class="form-label">Binding Types</label>
                    <select id="ddlBinding" class="form-select select2" multiple="multiple">
                    </select>
                </div>
                <div class="col-md-6" id="secFinishing" style="display:none;">
                    <label class="form-label">Finishing Processes</label>
                    <select id="ddlFinishings" class="form-select select2" multiple="multiple">
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Outsource -->
    <div class="card rc-section rc-section-secondary mb-3 rc-animate-in" id="secOutsource" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-secondary"><i class="bi bi-building-fill"></i></span>
                <div>
                    <h4 class="m-0">Outsource Job</h4>
                    <div class="text-secondary small">Third-party outsourced work details</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Vendor / Description</label>
                    <input id="txtVendorDesc" class="form-control" placeholder="Vendor name or job description" />
                </div>
                <div class="col-md-6">
                    <label class="form-label required">Outsource Cost (₹)</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">₹</span>
                        <input id="txtOutsourceCost" type="number" class="form-control" min="0" step="1" placeholder="Total cost" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Labour -->
    <div class="card rc-section rc-section-teal mb-3 rc-animate-in" id="secLabour" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-teal"><i class="bi bi-person-fill-gear"></i></span>
                <div>
                    <h4 class="m-0">Labour / Job Work</h4>
                    <div class="text-secondary small">Manual labour hours and rate</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Labour Type</label>
                    <input id="txtLabourType" class="form-control" placeholder="e.g. Packing, Sorting" />
                </div>
                <div class="col-md-4">
                    <label class="form-label required">Hours</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="bi bi-clock"></i></span>
                        <input id="txtLabourHours" type="number" class="form-control" min="0" step="0.5" placeholder="Hours" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label required">Rate (₹/hr)</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">₹</span>
                        <input id="txtLabourRate" type="number" class="form-control" min="0" step="1" placeholder="Rate per hour" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Area-Based -->
    <div class="card rc-section rc-section-lime mb-3 rc-animate-in" id="secArea" style="display:none;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="rc-step-number rc-step-lime"><i class="bi bi-aspect-ratio-fill"></i></span>
                <div>
                    <h4 class="m-0">Print Area (Flex / Large Format)</h4>
                    <div class="text-secondary small">Area dimensions for flex or large format printing</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label required">Width (ft)</label>
                    <input id="txtAreaWidth" type="number" class="form-control" min="0" step="0.5" placeholder="Width" />
                </div>
                <div class="col-md-4">
                    <label class="form-label required">Height (ft)</label>
                    <input id="txtAreaHeight" type="number" class="form-control" min="0" step="0.5" placeholder="Height" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Total Area</label>
                    <input id="txtTotalArea" class="form-control" readonly />
                </div>
            </div>
        </div>
    </div>

    <div id="aiSelectionInfo" class="alert alert-primary d-none mb-3">
        <div class="d-flex">
            <div class="me-2"><i class="bi bi-robot"></i></div>
            <div class="small" id="aiSelectionInfoText"></div>
        </div>
    </div>

    <!-- Calculate Button -->
    <div class="rc-action-strip mb-3">
        <label class="form-check form-switch me-3 mb-0 d-inline-flex align-items-center d-none">
            <input class="form-check-input" type="checkbox" id="chkAutoSmartRecommend" checked />
            <span class="form-check-label ms-2">Auto Smart</span>
        </label>
        <button id="btnSmartRecommend" type="button" class="btn btn-outline-primary me-2 d-none">
            <i class="bi bi-magic me-1"></i>Smart Recommend
        </button>
        <button id="btnCalculate" class="rc-btn-calculate-main">
            <span class="rc-btn-calc-icon"><i class="bi bi-calculator-fill"></i></span>
            <span>
                <strong>Calculate Cost</strong>
                <small>AI engine will compute pricing</small>
            </span>
            <span class="rc-kbd-hint d-none d-md-inline-flex"><kbd>Ctrl</kbd>+<kbd>Enter</kbd></span>
        </button>
    </div>
</div>

<!-- COST ESTIMATION BLOCK -->
<div class="row row-cards mt-3" id="costEstimationBlock" style="display:none;">
    <div class="col-12">
        <div class="rc-result-card-v2">
            <div class="rc-result-header-v2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rc-result-icon-pulse">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 text-white fw-bold">Cost Estimation</h3>
                        <div class="text-white-50 small">Generated by AI costing engine</div>
                    </div>
                </div>
                <span class="badge bg-white bg-opacity-25 text-white"><i class="bi bi-check-circle-fill me-1"></i>Calculated</span>
            </div>
            <div class="rc-result-body-v2">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="rc-metric-card rc-metric-green">
                            <div class="rc-metric-icon-wrap"><i class="bi bi-cash-stack"></i></div>
                            <div class="rc-metric-value" id="resGrandTotal">₹0.00</div>
                            <div class="rc-metric-label">Grand Total</div>
                            <div class="rc-metric-glow"></div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rc-metric-card rc-metric-amber">
                            <div class="rc-metric-icon-wrap"><i class="bi bi-percent"></i></div>
                            <div class="rc-metric-value" id="resTax">₹0.00</div>
                            <div class="rc-metric-label">GST (18%)</div>
                            <div class="rc-metric-glow"></div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rc-metric-card rc-metric-blue">
                            <div class="rc-metric-icon-wrap"><i class="bi bi-receipt"></i></div>
                            <div class="rc-metric-value" id="resNetTotal">₹0.00</div>
                            <div class="rc-metric-label">Net Total</div>
                            <div class="rc-metric-glow"></div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rc-metric-card rc-metric-dark">
                            <div class="rc-metric-icon-wrap"><i class="bi bi-tag-fill"></i></div>
                            <div class="rc-metric-value" id="resCostPerUnit">₹0.00</div>
                            <div class="rc-metric-label">Cost Per Unit</div>
                            <div class="rc-metric-glow"></div>
                        </div>
                    </div>
                </div>
                <div class="rc-action-bar-v2">
                    <button type="button" class="rc-action-chip rc-chip-green" data-bs-toggle="modal" data-bs-target="#modalBreakdown">
                        <i class="bi bi-list-check"></i><span>Cost Breakdown</span>
                    </button>
                    <button type="button" class="rc-action-chip rc-chip-purple" data-bs-toggle="modal" data-bs-target="#modalBom">
                        <i class="bi bi-box-seam"></i><span>BOM</span>
                    </button>
                    <button type="button" class="rc-action-chip rc-chip-amber" data-bs-toggle="modal" data-bs-target="#modalRules">
                        <i class="bi bi-gear-wide-connected"></i><span>Applied Rules</span>
                    </button>
                    <button type="button" class="rc-action-chip rc-chip-teal" data-bs-toggle="modal" data-bs-target="#modalDistribution">
                        <i class="bi bi-pie-chart-fill"></i><span>Distribution</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Cost Breakdown -->
<div class="modal modal-blur fade" id="modalBreakdown" tabindex="-1" aria-labelledby="modalBreakdownLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content rc-modal rc-modal-dark">
            <div class="rc-modal-accent"></div>
            <div class="modal-header rc-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="rc-modal-icon">
                        <i class="bi bi-list-check"></i>
                    </span>
                    <div>
                        <h5 class="modal-title mb-0" id="modalBreakdownLabel">Cost Breakdown</h5>
                        <div class="rc-modal-subtitle">Itemized cost components for this estimate</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rc-modal-count" id="breakdownCount">0 items</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="d-none d-md-block">
                    <div class="rc-grid-header">
                        <div class="rc-grid-row">
                            <div class="rc-grid-col" style="width:40px;">#</div>
                            <div class="rc-grid-col flex-fill">Component</div>
                            <div class="rc-grid-col" style="width:120px;">Category</div>
                            <div class="rc-grid-col flex-fill">Detail</div>
                            <div class="rc-grid-col text-end" style="width:140px;">Amount (₹)</div>
                        </div>
                    </div>
                    <div id="breakdownBodyTable" class="rc-grid-body"></div>
                </div>
                <div class="d-md-none p-3">
                    <div id="breakdownBodyCards" class="d-flex flex-column gap-2"></div>
                </div>
                <div class="rc-modal-empty d-none" id="breakdownEmpty">
                    <i class="bi bi-inbox"></i>
                    <div>No cost breakdown data available</div>
                </div>
            </div>
            <div class="modal-footer rc-modal-footer">
                <div class="rc-modal-footer-info">
                    <i class="bi bi-info-circle me-1"></i>All amounts are in INR (₹)
                </div>
                <button type="button" class="btn btn-ghost-dark" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: BOM -->
<div class="modal modal-blur fade" id="modalBom" tabindex="-1" aria-labelledby="modalBomLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content rc-modal rc-modal-purple">
            <div class="rc-modal-accent"></div>
            <div class="modal-header rc-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="rc-modal-icon">
                        <i class="bi bi-box-seam"></i>
                    </span>
                    <div>
                        <h5 class="modal-title mb-0" id="modalBomLabel">Bill of Materials</h5>
                        <div class="rc-modal-subtitle">Materials, quantities and rates used</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rc-modal-count" id="bomCount">0 items</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="d-none d-md-block">
                    <div class="rc-grid-header">
                        <div class="rc-grid-row">
                            <div class="rc-grid-col" style="width:120px;">Category</div>
                            <div class="rc-grid-col flex-fill">Item</div>
                            <div class="rc-grid-col flex-fill">Specification</div>
                            <div class="rc-grid-col text-end" style="width:100px;">Qty</div>
                            <div class="rc-grid-col" style="width:70px;">Unit</div>
                            <div class="rc-grid-col text-end" style="width:110px;">Rate</div>
                            <div class="rc-grid-col text-end" style="width:120px;">Amount</div>
                        </div>
                    </div>
                    <div id="bomBodyTable" class="rc-grid-body"></div>
                </div>
                <div class="d-md-none p-3">
                    <div id="bomBodyCards" class="d-flex flex-column gap-2"></div>
                </div>
                <div class="rc-modal-empty d-none" id="bomEmpty">
                    <i class="bi bi-inbox"></i>
                    <div>No materials data available</div>
                </div>
            </div>
            <div class="modal-footer rc-modal-footer">
                <div class="rc-modal-footer-info">
                    <i class="bi bi-layers me-1"></i>Bill of Materials
                </div>
                <button type="button" class="btn btn-ghost-purple" data-bs-dismiss="modal">
