@page
@model erp.minepress.web.Pages.Accounting.Receipt.CreateModel
@{
    ViewData["Title"] = "Record Receipt";
}

<!-- ── Compact Header Bar ── -->
<div class="rcpt-header d-print-none">
    <div class="d-flex align-items-center gap-3">
        <a href="/Accounting/Receipt" class="rcpt-back-btn" title="Back to Receipts">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="rcpt-title">New Receipt</h1>
            <div class="rcpt-subtitle" id="statusHint">Record customer payment &amp; allocate invoices</div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="rcpt-step-pills" id="wizardSteps">
            <span class="rcpt-pill active" id="ws1">1</span>
            <span class="rcpt-pill" id="ws2">2</span>
            <span class="rcpt-pill" id="ws3">3</span>
            <span class="rcpt-pill" id="ws4"><i class="bi bi-check-lg"></i></span>
        </span>
    </div>
</div>

<form id="receiptForm" autocomplete="off">
    <div class="rcpt-layout">

        <!-- ══════════════════════════════════════════════════════════
             LEFT COLUMN — Main form flow
             ══════════════════════════════════════════════════════════ -->
        <div class="rcpt-main">

            <!-- ── Customer Selection ── -->
            <div class="rcpt-card" id="section1">
                <div class="rcpt-card-label"><i class="bi bi-person"></i> Customer</div>
                <div class="rcpt-card-body">
                    <select id="ddlCustomer" class="form-select" required>
                        <option value="">Search customer by name or code…</option>
                    </select>

                    <!-- Compact customer detail strip -->
                    <div id="customerInfoPanel" class="rcpt-cust-strip" style="display:none;">
                        <div class="rcpt-cust-main">
                            <span class="rcpt-cust-name" id="custName"></span>
                            <span class="rcpt-cust-code" id="custCode"></span>
                            <span class="rcpt-cust-gst" id="custGst" style="display:none;">
                                <i class="bi bi-shield-check"></i><span id="custGstNo"></span>
                            </span>
                        </div>
                        <div class="rcpt-cust-meta">
                            <span id="custEmail"></span>
                            <span id="custMobile"></span>
                            <span class="rcpt-outstanding-pill" id="outstandingBadge" style="display:none;">
                                <i class="bi bi-receipt"></i><span id="outstandingCount">0</span> outstanding
                            </span>
                        </div>
                    </div>

                    <div id="customerPlaceholder" class="rcpt-empty-hint">
                        <i class="bi bi-search"></i> Type to search &amp; select a customer
                    </div>
                </div>
            </div>

            <!-- ── Receipt Details (date, ref, amount, mode) ── -->
            <div class="rcpt-card" id="section2">
                <div class="rcpt-card-label"><i class="bi bi-receipt-cutoff"></i> Payment Details</div>
                <div class="rcpt-card-body">
                    <div class="rcpt-detail-grid">
                        <!-- Amount — prominent -->
                        <div class="rcpt-amount-block">
                            <label class="rcpt-field-label">Amount Received</label>
                            <div class="rcpt-amount-input-wrap">
                                <span class="rcpt-currency">₹</span>
                                <input type="number" id="txtAmount" class="rcpt-amount-input" step="0.01" min="0.01" required placeholder="0.00" />
                            </div>
                        </div>

                        <!-- Fields row -->
                        <div class="rcpt-fields-row">
                            <div class="rcpt-field">
                                <label class="rcpt-field-label required">Receipt Date</label>
                                <input type="date" id="txtReceiptDate" class="form-control form-control-sm" required />
                            </div>
                            <div class="rcpt-field">
                                <label class="rcpt-field-label">Reference No</label>
                                <input type="text" id="txtRefNo" class="form-control form-control-sm" placeholder="Cheque / UTR / Txn ID" />
                            </div>
                            <div class="rcpt-field">
                                <label class="rcpt-field-label">Reference Date</label>
                                <input type="date" id="txtRefDate" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <!-- Payment Mode — horizontal pills -->
                        <div class="rcpt-paymode-section">
                            <label class="rcpt-field-label">Payment Mode</label>
                            <input type="hidden" id="ddlPaymentMode" value="" />
                            <div class="rcpt-paymode-row">
                                <button type="button" class="rcpt-mode-pill" data-mode="CASH" onclick="selectPayMode('CASH')">
                                    <i class="bi bi-cash-coin"></i> Cash
                                </button>
                                <button type="button" class="rcpt-mode-pill" data-mode="BANK_TRANSFER" onclick="selectPayMode('BANK_TRANSFER')">
                                    <i class="bi bi-bank"></i> Bank
                                </button>
                                <button type="button" class="rcpt-mode-pill" data-mode="CHEQUE" onclick="selectPayMode('CHEQUE')">
                                    <i class="bi bi-pencil-square"></i> Cheque
                                </button>
                                <button type="button" class="rcpt-mode-pill" data-mode="UPI" onclick="selectPayMode('UPI')">
                                    <i class="bi bi-phone"></i> UPI
                                </button>
                                <button type="button" class="rcpt-mode-pill" data-mode="NEFT" onclick="selectPayMode('NEFT')">
                                    <i class="bi bi-arrow-left-right"></i> NEFT
                                </button>
                                <button type="button" class="rcpt-mode-pill" data-mode="RTGS" onclick="selectPayMode('RTGS')">
                                    <i class="bi bi-lightning-charge"></i> RTGS
                                </button>
                            </div>
                            <div id="bankSection" style="display:none;" class="mt-2">
                                <select id="ddlBankAccount" class="form-select form-select-sm">
                                    <option value="">Select bank account…</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Invoice Allocation ── -->
            <div class="rcpt-card" id="section3">
                <div class="rcpt-card-label">
                    <span><i class="bi bi-layers"></i> Invoice Allocation</span>
                    <span class="rcpt-alloc-actions">
                        <button type="button" class="rcpt-link-btn" id="btnAutoAllocate" onclick="autoAllocate()">
                            <i class="bi bi-magic"></i> Auto Allocate
                        </button>
                        <button type="button" class="rcpt-link-btn rcpt-link-muted" onclick="clearAllocations()">
                            <i class="bi bi-x-circle"></i> Clear
                        </button>
                    </span>
                </div>
                <div class="rcpt-card-body p-0">
                    <!-- Allocation summary bar (top) -->
                    <div class="rcpt-alloc-bar" id="allocSummaryBar" style="display:none;">
                        <div class="rcpt-alloc-stat">
                            <span class="label">Receipt</span>
                            <span class="value text-primary" id="sumReceipt">₹0.00</span>
                        </div>
                        <div class="rcpt-alloc-stat">
                            <span class="label">Allocated</span>
                            <span class="value text-success" id="sumAllocated">₹0.00</span>
                        </div>
                        <div class="rcpt-alloc-stat">
                            <span class="label">Unallocated</span>
                            <span class="value" id="sumUnallocated">₹0.00</span>
                        </div>
                        <span class="badge" id="allocStatusBadge">Fully Allocated</span>
                    </div>

                    <!-- Column headers -->
                    <div class="rcpt-alloc-header" id="allocHeader" style="display:none;">
                        <span class="col-check"></span>
                        <span class="col-doc">Invoice</span>
                        <span class="col-date">Date / Due</span>
                        <span class="col-amt">Outstanding</span>
                        <span class="col-input">Allocate</span>
                    </div>

                    <!-- Allocation rows -->
                    <div id="allocBody"></div>

                    <!-- Empty state -->
                    <div class="rcpt-alloc-empty" id="allocEmptyState">
                        <i class="bi bi-inbox"></i>
                        <div>Select a customer to load outstanding invoices</div>
                    </div>
                </div>
            </div>

            <!-- ── Remarks ── -->
            <div class="rcpt-card">
                <div class="rcpt-card-label"><i class="bi bi-chat-left-text"></i> Remarks</div>
                <div class="rcpt-card-body">
                    <textarea id="txtRemarks" class="form-control form-control-sm" rows="2" placeholder="Internal notes or remarks…"></textarea>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT COLUMN — Live summary panel
             ══════════════════════════════════════════════════════════ -->
        <div class="rcpt-sidebar">
            <div class="rcpt-summary-card">
                <div class="rcpt-summary-title">Receipt Summary</div>

                <div class="rcpt-summary-amount-block">
                    <div class="rcpt-summary-amount" id="dispGrandTotal">₹0.00</div>
                    <div class="rcpt-summary-mode" id="dispModeLabel">—</div>
                </div>

                <div class="rcpt-summary-rows">
                    <div class="rcpt-summary-row">
                        <span>Total Outstanding</span>
                        <span class="text-danger" id="dispTotalOutstanding">₹0.00</span>
                    </div>
                    <div class="rcpt-summary-row">
                        <span>Allocated</span>
                        <span class="text-success" id="dispAllocated">₹0.00</span>
                    </div>
                    <div class="rcpt-summary-row">
                        <span>Unallocated</span>
                        <span id="dispUnallocated">₹0.00</span>
                    </div>
                    <div class="rcpt-summary-divider"></div>
                    <div class="rcpt-summary-row">
                        <span>Invoices Covered</span>
                        <span id="dispInvoiceCount">0</span>
                    </div>
                    <div class="rcpt-summary-row">
                        <span>Paid (this receipt)</span>
                        <span class="text-success fw-semibold" id="dispPaidAmount">₹0.00</span>
                    </div>
                    <div class="rcpt-summary-row">
                        <span>Balance After</span>
                        <span class="text-danger fw-semibold" id="dispBalanceAmount">₹0.00</span>
                    </div>
                </div>

                <div class="rcpt-summary-actions">
                    <button type="button" class="btn btn-primary w-100" onclick="saveReceipt()" id="btnSave">
                        <i class="bi bi-check-lg me-1"></i>Save Receipt
                    </button>
                    <a href="/Accounting/Receipt" class="btn btn-outline-secondary w-100 btn-sm mt-2">Cancel</a>
                </div>
            </div>
        </div>

    </div><!-- /rcpt-layout -->
</form>

@section Scripts {
    <script>
        const ACC_API = '/api/accounting';
        let outstandingData = [];
        let customerData = null;

        $(document).ready(function () {
            $('#txtReceiptDate').val(new Date().toISOString().split('T')[0]);
            loadBankAccounts();

            $('#ddlCustomer').select2({
                theme: 'bootstrap-5',
                placeholder: 'Search customer by name or code…',
                allowClear: true,
                ajax: {
                    url: `${ACC_API}/parties`,
                    dataType: 'json',
                    delay: 300,
                    data: params => ({ q: params.term }),
                    processResults: data => ({ results: data.map(p => ({ id: p.id, text: `${p.text} (${p.code || ''})` })) }),
                    cache: true
                },
                minimumInputLength: 1
            });

            $('#ddlCustomer').on('change', function () {
                const partyId = $(this).val();
                if (partyId) {
                    loadPartyDetail(partyId);
                    loadOutstanding(partyId);
                    updateWizard(2);
                } else {
                    clearCustomerData();
                    updateWizard(1);
                }
            });

            $('#txtAmount').on('input change', function () {
                updateAllocSummary();
                updateTotals();
            });
        });

        // ── Load Bank Accounts ──
        function loadBankAccounts() {
            $.get(`${ACC_API}/bank-accounts`, function (data) {
                data.forEach(b => {
                    $('#ddlBankAccount').append(`<option value="${b.bankAccountId}">${esc(b.accountName)} — ${esc(b.bankName)}</option>`);
                });
            });
        }

        // ── Load Party Detail ──
        function loadPartyDetail(partyId) {
            $.get(`${ACC_API}/party-detail/${partyId}`, function (d) {
                customerData = d;
                $('#customerPlaceholder').hide();
                $('#customerInfoPanel').show();
                $('#custName').text(d.name);
                $('#custCode').text(d.code || '');
                $('#custEmail').html(d.email ? `<i class="bi bi-envelope me-1"></i>${esc(d.email)}` : '');
                $('#custMobile').html(d.mobile ? `<i class="bi bi-telephone me-1"></i>${esc(d.mobile)}` : '');
                if (d.gstno) {
                    $('#custGst').show();
                    $('#custGstNo').text(d.gstno);
                } else {
                    $('#custGst').hide();
                }
                $('#statusHint').html(`<i class="bi bi-person-check me-1"></i>${esc(d.name)} — enter payment details`);
            }).fail(function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load customer details.' });
            });
        }

        function clearCustomerData() {
            customerData = null;
            outstandingData = [];
            $('#customerInfoPanel').hide();
            $('#customerPlaceholder').show();
            $('#outstandingBadge').hide();
            $('#allocEmptyState').show();
            $('#allocHeader').hide();
            $('#allocBody').html('');
            $('#allocSummaryBar').hide();
            updateTotals();
            $('#statusHint').html('Record customer payment &amp; allocate invoices');
        }

        // ── Payment Mode ──
        function selectPayMode(mode) {
            $('#ddlPaymentMode').val(mode);
            $('.rcpt-mode-pill').removeClass('active');
            $(`.rcpt-mode-pill[data-mode="${mode}"]`).addClass('active');
            if (mode === 'CASH') {
                $('#bankSection').slideUp(200);
                $('#ddlBankAccount').val('');
            } else {
                $('#bankSection').slideDown(200);
            }
            // Update summary label
            const labels = { CASH: 'Cash', BANK_TRANSFER: 'Bank Transfer', CHEQUE: 'Cheque', UPI: 'UPI', NEFT: 'NEFT', RTGS: 'RTGS' };
            $('#dispModeLabel').text(labels[mode] || mode);
            updateWizard(2);
        }

        // ── Load Outstanding Invoices ──
        function loadOutstanding(partyId) {
            if (!partyId) return;
            $.get(`${ACC_API}/ar-outstanding?partyId=${partyId}`, function (data) {
                outstandingData = data;
                if (data.length) {
                    $('#allocEmptyState').hide();
                    $('#allocHeader').show();
                    $('#outstandingBadge').show();
                    $('#outstandingCount').text(data.length);
                    renderAllocItems();
                    $('#allocSummaryBar').show();
                    updateAllocSummary();
                    updateTotals();
                    updateWizard(3);
                    $('#statusHint').html(`<i class="bi bi-layers me-1"></i>${data.length} outstanding — allocate receipt`);
                } else {
                    $('#allocEmptyState').show().find('div').first().text('No outstanding invoices for this customer');
                    $('#allocHeader').hide();
                    $('#allocBody').html('');
                    $('#outstandingBadge').hide();
                    $('#allocSummaryBar').hide();
                    updateTotals();
                }
            }).fail(function () {});
        }

        function renderAllocItems() {
            let html = '';
            outstandingData.forEach((inv, idx) => {
                const isOverdue = inv.overdueDays && inv.overdueDays > 0;
                html += `<div class="rcpt-alloc-row" id="allocItem${idx}">
                    <span class="col-check">
                        <span class="rcpt-alloc-check" onclick="toggleAllocItem(${idx})"></span>
                    </span>
                    <span class="col-doc">
                        <span class="rcpt-doc-no">${esc(inv.documentNo)}</span>
                        ${isOverdue ? `<span class="rcpt-overdue">${inv.overdueDays}d</span>` : ''}
                    </span>
                    <span class="col-date">
                        <span>${esc(inv.documentDate)}</span>
                        <span class="rcpt-due">${esc(inv.dueDate || '—')}</span>
                    </span>
                    <span class="col-amt">${fmt(inv.outstandingAmount)}</span>
                    <span class="col-input">
                        <input type="number" class="form-control form-control-sm alloc-amt-input"
                               data-idx="${idx}" step="0.01" min="0" max="${inv.outstandingAmount}"
                               value="0" onchange="onAllocAmtChange(${idx})" oninput="onAllocAmtChange(${idx})" />
                    </span>
                </div>`;
            });
            $('#allocBody').html(html);
        }

        function toggleAllocItem(idx) {
            const $input = $(`.alloc-amt-input[data-idx="${idx}"]`);
            const currentVal = parseFloat($input.val()) || 0;
            if (currentVal > 0) {
                $input.val('0');
            } else {
                const outstanding = outstandingData[idx]?.outstandingAmount || 0;
                const receiptAmt = parseFloat($('#txtAmount').val()) || 0;
                const currentAllocTotal = getTotalAllocated();
                const remaining = receiptAmt - currentAllocTotal;
                $input.val(Math.min(remaining > 0 ? remaining : outstanding, outstanding).toFixed(2));
            }
            onAllocAmtChange(idx);
        }

        function onAllocAmtChange(idx) {
            const $input = $(`.alloc-amt-input[data-idx="${idx}"]`);
            const val = parseFloat($input.val()) || 0;
            const max = outstandingData[idx]?.outstandingAmount || 0;
            if (val > max) $input.val(max.toFixed(2));
            const $row = $(`#allocItem${idx}`);
            if (val > 0) {
                $row.addClass('allocated');
                $row.find('.rcpt-alloc-check').html('<i class="bi bi-check-lg"></i>');
            } else {
                $row.removeClass('allocated');
                $row.find('.rcpt-alloc-check').html('');
            }
            updateAllocSummary();
            updateTotals();
        }

        function getTotalAllocated() {
            let total = 0;
            $('.alloc-amt-input').each(function () { total += parseFloat($(this).val()) || 0; });
            return total;
        }

        function autoAllocate() {
            const amt = parseFloat($('#txtAmount').val()) || 0;
            if (amt <= 0) {
                Swal.fire({ icon: 'warning', title: 'Enter Amount', text: 'Please enter the receipt amount before auto-allocating.' });
                return;
            }
            let remaining = amt;
            outstandingData.forEach((inv, idx) => {
                const $input = $(`.alloc-amt-input[data-idx="${idx}"]`);
                if (remaining > 0) {
                    const alloc = Math.min(remaining, inv.outstandingAmount);
                    $input.val(alloc.toFixed(2));
                    remaining -= alloc;
                } else {
                    $input.val('0');
                }
                onAllocAmtChange(idx);
            });
        }

        function clearAllocations() {
            $('.alloc-amt-input').val('0');
            outstandingData.forEach((_, idx) => onAllocAmtChange(idx));
        }

        function updateAllocSummary() {
            const receiptAmt = parseFloat($('#txtAmount').val()) || 0;
            const allocated = getTotalAllocated();
            const unallocated = receiptAmt - allocated;
            $('#sumReceipt').text(fmt(receiptAmt));
            $('#sumAllocated').text(fmt(allocated));
            $('#sumUnallocated').text(fmt(unallocated));
            if (unallocated === 0 && receiptAmt > 0) {
                $('#sumUnallocated').removeClass('text-warning text-danger').addClass('text-success');
                $('#allocStatusBadge').attr('class', 'badge bg-success-lt').text('Fully Allocated');
            } else if (unallocated > 0) {
                $('#sumUnallocated').removeClass('text-success text-danger').addClass('text-warning');
                $('#allocStatusBadge').attr('class', 'badge bg-warning-lt').text('Partially Allocated');
            } else if (unallocated < 0) {
                $('#sumUnallocated').removeClass('text-success text-warning').addClass('text-danger');
                $('#allocStatusBadge').attr('class', 'badge bg-danger-lt').text('Over Allocated');
            }
            if (allocated > 0) updateWizard(4);
            else if (outstandingData.length > 0) updateWizard(3);
        }

        function updateTotals() {
            const receiptAmt = parseFloat($('#txtAmount').val()) || 0;
            const allocated = getTotalAllocated();
            const unallocated = receiptAmt - allocated;
            let totalOutstanding = 0;
            outstandingData.forEach(inv => { totalOutstanding += inv.outstandingAmount || 0; });
            let invoiceCount = 0;
            $('.alloc-amt-input').each(function () { if ((parseFloat($(this).val()) || 0) > 0) invoiceCount++; });

            $('#dispGrandTotal').text(fmt(receiptAmt));
            $('#dispTotalOutstanding').text(fmt(totalOutstanding));
            $('#dispAllocated').text(fmt(allocated));
            $('#dispUnallocated').text(fmt(unallocated)).attr('class', `${unallocated > 0 ? 'text-warning' : unallocated < 0 ? 'text-danger' : 'text-success'}`);
            $('#dispInvoiceCount').text(invoiceCount);
            $('#dispPaidAmount').text(fmt(allocated));
            $('#dispBalanceAmount').text(fmt(Math.max(0, totalOutstanding - allocated)));
        }

        // ── Wizard ──
        function updateWizard(step) {
            for (let i = 1; i <= 4; i++) {
                const $pill = $(`#ws${i}`);
                $pill.removeClass('active completed');
                if (i < step) $pill.addClass('completed');
                else if (i === step) $pill.addClass('active');
            }
        }

        // ── Save Receipt ──
        async function saveReceipt() {
            if (!$('#ddlCustomer').val()) {
                Swal.fire({ icon: 'warning', title: 'Customer Required', text: 'Please select a customer.' });
                return;
            }
            const amt = parseFloat($('#txtAmount').val()) || 0;
            if (amt <= 0) {
                Swal.fire({ icon: 'warning', title: 'Amount Required', text: 'Please enter a valid receipt amount.' });
                return;
            }
            if (!$('#ddlPaymentMode').val()) {
                Swal.fire({ icon: 'warning', title: 'Payment Mode', text: 'Please select a payment method.' });
                return;
            }

            const allocations = [];
            $('.alloc-amt-input').each(function () {
                const idx = $(this).data('idx');
                const allocAmt = parseFloat($(this).val()) || 0;
                if (allocAmt > 0 && outstandingData[idx]) {
                    allocations.push({
                        arId: outstandingData[idx].arId,
                        invoiceId: 0,
                        documentNo: outstandingData[idx].documentNo,
                        allocatedAmount: allocAmt
                    });
                }
            });

            const payload = {
                receiptDate: $('#txtReceiptDate').val(),
                partyId: parseInt($('#ddlCustomer').val()),
                paymentMode: $('#ddlPaymentMode').val(),
                amount: amt,
                bankId: $('#ddlBankAccount').val() ? parseInt($('#ddlBankAccount').val()) : null,
                referenceNo: $('#txtRefNo').val() || null,
                referenceDate: $('#txtRefDate').val() || null,
                remarks: $('#txtRemarks').val() || null,
                allocations: allocations
            };

            try {
                Swal.fire({ title: 'Saving Receipt…', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                const result = await $.ajax({
                    url: `${ACC_API}/receipt/save`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload)
                });
                Swal.close();
                showReceiptAcknowledgement(result);
            } catch (err) {
                const errData = err.responseJSON;
                let msg = errData?.message || 'Failed to save receipt.';
                if (errData?.errors && errData.errors.length) {
                    msg += '<ul class="text-start mt-2 mb-0" style="font-size:.85rem;">';
                    errData.errors.forEach(e => { msg += `<li>${esc(e)}</li>`; });
                    msg += '</ul>';
                }
                Swal.fire({ icon: 'error', title: 'Validation Error', html: msg });
            }
        }

        // ── Post-Save Acknowledgement ──
        function showReceiptAcknowledgement(result) {
            const receiptId = result.receiptId;
            const receiptNo = result.receiptNo;
            const amount = result.amount;
            const customerName = result.customerName || 'Customer';
            const receiptDate = result.receiptDate || '';
            const paymentMode = result.paymentMode || '';
            const allocatedCount = result.allocatedCount || 0;

            Swal.fire({
                icon: 'success',
                title: 'Receipt Saved!',
                html: `<div class="text-center">
                    <div class="mb-2" style="font-size:1.4rem; font-weight:700; color:#206bc4;">${esc(receiptNo)}</div>
                    <div class="mb-1"><strong>${esc(customerName)}</strong></div>
                    <div style="font-size:1.2rem; font-weight:600;">₹${Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
                    <div class="text-muted small mt-1">${esc(receiptDate)} · ${esc(paymentMode)}</div>
                    ${allocatedCount > 0 ? `<div class="text-muted small">Allocated against ${allocatedCount} invoice(s)</div>` : ''}
                    <hr/>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button class="btn btn-primary btn-sm" onclick="printSavedReceipt(${receiptId})">
                            <i class="bi bi-printer me-1"></i>Print
                        </button>
                        <button class="btn btn-outline-success btn-sm" onclick="emailSavedReceipt(${receiptId})">
                            <i class="bi bi-envelope me-1"></i>Email
                        </button>
                        <button class="btn btn-outline-success btn-sm" onclick="whatsAppSavedReceipt('${esc(receiptNo)}', '${esc(customerName)}', ${amount})">
                            <i class="bi bi-whatsapp me-1"></i>WhatsApp
                        </button>
                    </div>
                </div>`,
                showConfirmButton: true,
                confirmButtonText: '<i class="bi bi-arrow-left me-1"></i>Back to Receipts',
                allowOutsideClick: false
            }).then(() => {
                window.location.href = '/Accounting/Receipt';
            });
        }

        function printSavedReceipt(receiptId) {
            $.get(`${ACC_API}/receipt/${receiptId}`, function (d) {
                let allocHtml = '';
                if (d.allocations && d.allocations.length > 0) {
                    allocHtml = `<table class="table table-sm table-bordered mt-3" style="font-size:.82rem;">
                        <thead><tr><th>Invoice No</th><th>Invoice Date</th><th class="text-end">Invoice Total</th><th class="text-end">Allocated</th></tr></thead>
                        <tbody>`;
                    d.allocations.forEach(a => {
                        allocHtml += `<tr><td>${esc(a.invoiceNo || '')}</td><td>${esc(a.invoiceDate || '')}</td><td class="text-end">${fmt(a.invoiceTotal)}</td><td class="text-end fw-semibold">${fmt(a.allocatedAmount)}</td></tr>`;
                    });
                    allocHtml += `</tbody></table>`;
                }
                const content = `
                    <div style="border:1px solid #dee2e6; padding:24px;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:16px;">
                            <div>
                                <h4 style="margin:0 0 4px;">${esc(d.companyName || '')}</h4>
                                <div style="color:#666; font-size:.85rem;">${esc(d.companyAddress || '')}</div>
                                ${d.companyGstin ? `<div style="font-size:.85rem;"><strong>GSTIN:</strong> ${esc(d.companyGstin)}</div>` : ''}
                            </div>
                            <div style="text-align:right;">
                                <h5 style="color:#206bc4; margin:0 0 4px;">PAYMENT RECEIPT</h5>
                                <div><strong>${esc(d.receiptNo)}</strong></div>
                                <div style="color:#666; font-size:.85rem;">Date: ${esc(d.receiptDate)}</div>
                            </div>
                        </div>
                        <hr/>
                        <div style="display:flex; justify-content:space-between; margin-bottom:16px;">
                            <div>
                                <div style="color:#666; font-size:.8rem; margin-bottom:4px;">Received From</div>
                                <div style="font-weight:600;">${esc(d.customerName || '')}</div>
                                ${d.customerGst ? `<div style="font-size:.85rem;">GSTIN: ${esc(d.customerGst)}</div>` : ''}
                            </div>
                            <div style="text-align:right;">
                                <div style="color:#666; font-size:.8rem; margin-bottom:4px;">Payment Details</div>
                                <div style="font-size:.85rem;"><strong>Mode:</strong> ${esc(d.paymentMode || '')}</div>
                                ${d.referenceNo ? `<div style="font-size:.85rem;"><strong>Ref:</strong> ${esc(d.referenceNo)}</div>` : ''}
                                ${d.bankName ? `<div style="font-size:.85rem;"><strong>Bank:</strong> ${esc(d.bankName)}</div>` : ''}
                            </div>
                        </div>
                        <div style="background:#f8f9fa; border-radius:6px; padding:16px; text-align:center; margin-bottom:16px;">
                            <div style="color:#666; font-size:.85rem; margin-bottom:4px;">Amount Received</div>
                            <div style="font-size:1.5rem; font-weight:700; color:#206bc4;">${fmt(d.amount)}</div>
                        </div>
                        ${allocHtml}
                        ${d.remarks ? `<div style="margin-top:12px; font-size:.85rem;"><strong>Remarks:</strong> ${esc(d.remarks)}</div>` : ''}
                        <hr/>
                        <div style="display:flex; justify-content:space-between; font-size:.8rem; color:#999;">
                            <div>This is a computer-generated receipt.</div>
                            <div>${esc(d.createdOn || '')}</div>
                        </div>
                    </div>`;
                var win = window.open('', '_blank', 'width=800,height=600');
                var doc = win.document;
                doc.open();
                doc.write('\x3Chtml>\x3Chead>\x3Ctitle>Receipt ' + esc(d.receiptNo) + '\x3C/title>');
                doc.write('\x3Clink rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css"/>');
                doc.write('\x3Cstyle>body{padding:20px;}\x3C/style>');
                doc.write('\x3C/head>\x3Cbody>' + content + '\x3C/body>\x3C/html>');
                doc.close();
                setTimeout(function () { win.focus(); win.print(); }, 500);
            }).fail(function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to load receipt for printing.' });
            });
        }

        function emailSavedReceipt(receiptId) {
            $.ajax({
                url: `${ACC_API}/receipt/${receiptId}/send-email`,
                method: 'POST'
            }).done(function (res) {
                Swal.fire({ icon: 'success', title: 'Email Sent', text: res.message, timer: 2000, showConfirmButton: false });
            }).fail(function (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: err.responseJSON?.message || 'Failed to send email.' });
            });
        }

        function whatsAppSavedReceipt(receiptNo, customerName, amount) {
            const text = `Payment Receipt ${receiptNo}\nCustomer: ${customerName}\nAmount: ₹${Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}\n\nThank you for your payment!`;
            window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
        }

        // ── Utilities ──
        function fmt(v) { return v != null ? '₹' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '₹0.00'; }
        function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.appendChild(document.createTextNode(s)); return d.innerHTML; }
    </script>
}
