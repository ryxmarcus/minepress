@page
@model erp.minepress.web.Pages.Hrms.Shift.IndexModel
@{
    ViewData["Title"] = "Shift Roster — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-clock" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Shift Roster</h2>
            <div class="text-white-75">View your shift assignments and schedule</div>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-light btn-sm" onclick="Hrms.loadShifts()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- Shift Types Overview -->
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Available Shift Types</h3>
    </div>
    <div class="card-body" id="shiftTypesContainer">
        <div class="text-center text-secondary py-3">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
        </div>
    </div>
</div>

<!-- Roster Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">My Shift Roster</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Shift Name</th>
                    <th>Shift Code</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Effective From</th>
                    <th>Effective To</th>
                    <th>Week Off</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody id="shiftTableBody">
                <tr>
                    <td colspan="8" class="text-center text-secondary py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Hrms.loadShifts());
    </script>
}
