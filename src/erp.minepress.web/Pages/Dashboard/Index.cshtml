<!-- ═══ Attendance Tracker (Top Management / Administration / SysAdmin) ═══ -->
@if (Model.CanViewAllDepts)
{
<div class="row g-3 mb-3" id="attendanceTrackerSection">
    <div class="col-12">
        <div class="card dash-tracker-card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-people-fill me-2"></i>Today's Attendance Tracker
                </h3>
                <div class="card-actions d-flex align-items-center gap-2">
                    <span class="badge bg-success-lt" id="trackerPresentBadge">0 Present</span>
                    <span class="badge bg-danger-lt" id="trackerAbsentBadge">0 Not Punched</span>
                    <span class="badge bg-warning-lt" id="trackerLeaveBadge">0 On Leave</span>
                    <button class="btn btn-sm btn-ghost-primary" onclick="Dashboard.refreshTracker()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- Not Punched In -->
                    <div class="col-lg-6">
                        <div class="dash-tracker-panel dash-tracker-absent">
                            <div class="dash-tracker-panel-header">
                                <i class="bi bi-person-x me-2 text-danger"></i>
                                <span class="fw-bold">Not Punched In</span>
                                <span class="badge bg-danger-lt ms-auto" id="trackerNotPunchedCount">0</span>
                            </div>
                            <div class="dash-tracker-list" id="trackerNotPunchedList">
                                <div class="text-center text-muted py-3 small">
                                    <div class="spinner-border spinner-border-sm text-danger me-1"></div>Loading...
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- On Leave -->
                    <div class="col-lg-6">
                        <div class="dash-tracker-panel dash-tracker-leave">
                            <div class="dash-tracker-panel-header">
                                <i class="bi bi-calendar-x me-2 text-warning"></i>
                                <span class="fw-bold">On Leave Today</span>
                                <span class="badge bg-warning-lt ms-auto" id="trackerOnLeaveCount">0</span>
                            </div>
                            <div class="dash-tracker-list" id="trackerOnLeaveList">
                                <div class="text-center text-muted py-3 small">
                                    <div class="spinner-border spinner-border-sm text-warning me-1"></div>Loading...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

<!-- ═══ KPI + Activity + Actions Row ═══ -->
<div class="row g-3 mb-3">
    <!-- Department KPIs -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-bar-chart-line me-2"></i>Department KPIs — <span id="kpiDeptLabel">@Model.DeptName</span></h3>
                <div class="card-actions">
                    <span class="badge bg-primary-lt" id="kpiDeptBadge">@Model.DeptCode</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3" id="kpiContainer">
                    <div class="col-12 text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading KPIs...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance & Quick Info -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-person-check me-2"></i>Today's Status</h3>
            </div>
            <div class="card-body">
                <div class="mb-3" id="attendancePanel">
                    <div class="d-flex align-items-center mb-2">
                        <span class="avatar avatar-sm bg-success-lt me-2"><i class="bi bi-box-arrow-in-right"></i></span>
                        <div>
                            <div class="small text-secondary">Login Time</div>
                            <div class="fw-semibold" id="attendLogin">—</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="avatar avatar-sm bg-secondary-lt me-2"><i class="bi bi-box-arrow-right"></i></span>
                        <div>
                            <div class="small text-secondary">Logout Time</div>
                            <div class="fw-semibold" id="attendLogout">—</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="avatar avatar-sm bg-primary-lt me-2"><i class="bi bi-activity"></i></span>
                        <div>
                            <div class="small text-secondary">Today's Activities</div>
                            <div class="fw-semibold" id="attendActivities">—</div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small text-secondary">Active Jobs</span>
                    <span class="fw-bold" id="infoActiveJobs">—</span>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="small text-secondary">Today Enquiries</span>
                    <span class="fw-bold" id="infoTodayEnq">—</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Activities + Actions + AI Alerts ═══ -->
<div class="row g-3 mb-3">
    <!-- Recent Activities -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-clock-history me-2"></i>Recent Activities</h3>
            </div>
            <div class="list-group list-group-flush dash-activity-list" id="activityList">
                <div class="list-group-item text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading...
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Actions -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-lightning-charge me-2"></i>Pending Actions</h3>
                <div class="card-actions">
                    <span class="badge bg-warning-lt" id="actionCount">0</span>
                </div>
            </div>
            <div class="list-group list-group-flush dash-action-list" id="actionList">
                <div class="list-group-item text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm text-warning me-2"></div>Loading...
                </div>
            </div>
        </div>
    </div>

    <!-- AI Smart Suggestions -->
    <div class="col-lg-4">
        <div class="card h-100 dash-ai-suggestions-card">
            <div class="card-header dash-ai-suggestions-header">
                <h3 class="card-title">
                    <span class="dash-ai-pulse me-2"></span>
                    <i class="bi bi-stars me-2"></i>AI Smart Suggestions
                </h3>
                <div class="card-actions">
                    <span class="badge bg-purple-lt"><i class="bi bi-cpu me-1"></i>AI</span>
                </div>
            </div>
            <div class="list-group list-group-flush dash-ai-suggestions-list" id="aiSuggestionList">
                <div class="list-group-item text-center text-muted py-4">
                    <div class="dash-ai-thinking">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="small mt-2">AI is analyzing your data...</div>
                </div>
            </div>
            <div class="card-footer dash-ai-suggestions-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-secondary"><i class="bi bi-info-circle me-1"></i>Personalized insights</small>
                    <button class="btn btn-sm btn-ghost-purple" onclick="Dashboard.refreshAi()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/dashboard.js"></script>
}
