@*
    Shared HSN/SAC Tax Selector — reusable across Enquiry, Quotation, Job pages.
    Usage: <partial name="_HsnSacTaxPartial" />
    Requires: jQuery. Exposes: HsnSacSelector.init(options)
*@

<div id="hsnSacWidget">
    <label class="form-label mb-1">
        <i class="bi bi-receipt me-1 text-secondary"></i>
        Tax (HSN/SAC) <span class="text-secondary fw-normal">— GST Code</span>
    </label>

    <!-- Selector Box: Tabs + Search -->
    <div class="hsn-selector-box">

        <!-- Type Tabs -->
        <div class="hsn-type-tabs">
            <button type="button" class="hsn-type-tab active" data-type="ALL">
                <i class="bi bi-grid-3x3-gap-fill me-1"></i>All
            </button>
            <button type="button" class="hsn-type-tab" data-type="HSN">
                <span class="hsn-type-badge hsn">HSN</span>
                <span class="hsn-tab-label">Goods</span>
            </button>
            <button type="button" class="hsn-type-tab" data-type="SAC">
                <span class="hsn-type-badge sac">SAC</span>
                <span class="hsn-tab-label">Services</span>
            </button>
        </div>

        <!-- Search Row -->
        <div class="hsn-search-row">
            <i class="bi bi-search hsn-search-icon"></i>
            <input type="text" id="hsnSearchInput" class="form-control form-control-sm hsn-input"
                   placeholder="Type code or description to search…" autocomplete="off" />
            <span id="hsnSearchSpinner" class="spinner-border spinner-border-sm hsn-spinner d-none"></span>
        </div>
    </div>

    <!-- Dropdown Results -->
    <div id="hsnDropdown" class="hsn-dropdown d-none">
        <div id="hsnResults" class="hsn-results"></div>
        <div id="hsnNoResult" class="hsn-no-result d-none">
            <i class="bi bi-search"></i>
            <span>No matching HSN/SAC codes</span>
        </div>
        <div id="hsnTypeHint" class="hsn-type-hint">
            <i class="bi bi-keyboard me-1"></i>Type at least 1 character to search
        </div>
    </div>

    <!-- Selected Tax Badge -->
    <div id="hsnSelectedBadge" class="hsn-selected d-none">
        <div class="d-flex align-items-center gap-2">
            <div class="hsn-sel-icon">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="flex-fill hsn-sel-body">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <span class="hsn-type-badge" id="hsnSelTypeBadge">HSN</span>
                    <span class="hsn-sel-code" id="hsnSelCode"></span>
                </div>
                <div class="hsn-sel-desc" id="hsnSelDesc"></div>
            </div>
            <span class="badge bg-yellow-lt fw-bold hsn-sel-rate" id="hsnSelRate"></span>
            <button type="button" class="btn btn-ghost-secondary btn-sm btn-icon flex-shrink-0" id="hsnClearBtn" title="Clear">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <input type="hidden" id="hsnSelectedId" value="" />
    <input type="hidden" id="hsnSelectedRate" value="0" />
</div>
