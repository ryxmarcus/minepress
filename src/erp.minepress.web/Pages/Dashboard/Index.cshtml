@page
@model erp.minepress.web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- ═══ Hero Header ═══ -->
<div class="dash-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg dash-hero-avatar">
                <i class="bi bi-speedometer2" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-1" id="heroGreeting">Welcome back, @Model.UserFullName</h2>
            <div class="text-white-75 d-flex align-items-center gap-2">
                <span class="badge bg-white text-dark">
                    <i class="bi bi-building me-1"></i>@Model.DeptCode — @Model.DeptName
                </span>
                <span id="heroTime" class="small opacity-75"></span>
            </div>
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <a href="/Dashboard/@Model.DeptCode" class="btn btn-outline-light btn-sm">
                <i class="bi bi-grid-1x2 me-1"></i>My Department
            </a>
            <button class="btn btn-outline-light btn-sm" onclick="Dashboard.refresh()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- ═══ Punch In/Punch Out Widget ═══ -->
<div class="row g-3 mb-3" id="punchWidgetSection">
    <div class="col-lg-7">
        <div class="card punch-card">
            <div class="punch-card-glow"></div>
            <div class="card-body p-0">
                <div class="row g-0 align-items-stretch">
                    <!-- Left: Clock & Punch Button -->
                    <div class="col-md-5 punch-clock-section">
                        <div class="punch-clock-inner">
                            <div class="punch-live-clock" id="punchLiveClock">--:--:--</div>
                            <div class="punch-live-date" id="punchLiveDate"></div>
                            <div class="punch-btn-container mt-3">
                                <button class="punch-btn punch-btn-in" id="punchActionBtn" onclick="Dashboard.doPunch()" disabled>
                                    <span class="punch-btn-icon"><i class="bi bi-finger-print"></i></span>
                                    <span class="punch-btn-text" id="punchBtnText">Loading...</span>
                                </button>
                            </div>
                            <div class="punch-status-badge mt-2" id="punchStatusBadge">
                                <span class="badge bg-secondary-lt"><i class="bi bi-circle me-1"></i>Loading...</span>
                            </div>
                        </div>
                    </div>
                    <!-- Right: Status Details -->
                    <div class="col-md-7 punch-details-section">
                        <div class="p-3">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="mb-0 fw-bold"><i class="bi bi-stopwatch me-2 text-primary"></i>Attendance Tracker</h4>
                                <span class="punch-ai-badge"><i class="bi bi-cpu me-1"></i>AI Powered</span>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="punch-info-card punch-info-in">
                                        <div class="punch-info-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                                        <div class="punch-info-label">Punch In</div>
                                        <div class="punch-info-value" id="punchInTime">--:--</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="punch-info-card punch-info-out">
                                        <div class="punch-info-icon"><i class="bi bi-box-arrow-right"></i></div>
                                        <div class="punch-info-label">Punch Out</div>
                                        <div class="punch-info-value" id="punchOutTime">--:--</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="punch-info-card punch-info-hours">
                                        <div class="punch-info-icon"><i class="bi bi-hourglass-split"></i></div>
                                        <div class="punch-info-label">Work Hours</div>
                                        <div class="punch-info-value" id="punchWorkHours">0h 0m</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="punch-info-card punch-info-shift">
                                        <div class="punch-info-icon"><i class="bi bi-sun"></i></div>
                                        <div class="punch-info-label">Shift</div>
                                        <div class="punch-info-value" id="punchShiftInfo">—</div>
                                    </div>
                                </div>
                            </div>
                            <!-- Work Progress Bar -->
                            <div class="punch-progress-section" id="punchProgressSection" style="display:none;">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-secondary">Work Progress</span>
                                    <span class="fw-bold text-primary" id="punchProgressPct">0%</span>
                                </div>
                                <div class="progress punch-progress">
                                    <div class="progress-bar punch-progress-bar" id="punchProgressBar" role="progressbar" style="width:0%"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-1" style="font-size:.65rem;">
                                    <span class="text-secondary">0h</span>
                                    <span class="text-secondary">8h (Standard)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- AI Attendance Insights -->
    <div class="col-lg-5">
        <div class="card punch-ai-card h-100">
            <div class="card-header punch-ai-header">
                <h3 class="card-title">
                    <span class="punch-ai-pulse me-2"></span>
                    <i class="bi bi-stars me-1"></i>AI Attendance Insights
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush punch-ai-list" id="punchAiInsightsList">
                    <div class="list-group-item text-center text-muted py-4">
                        <div class="punch-ai-thinking-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <div class="small mt-2">AI analyzing your attendance patterns...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Stat Cards Row ═══ -->
<div class="row g-3 mb-3" id="dashStats">
    <div class="col-6 col-lg-3 col-xl">
        <div class="card card-sm dash-stat-card" data-stat="tasks">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-primary-lt me-3"><i class="bi bi-list-task"></i></span>
                    <div>
                        <div class="fw-bold fs-3 dash-counter" id="statTasks">—</div>
                        <div class="text-secondary small">Tasks Assigned</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 col-xl">
        <div class="card card-sm dash-stat-card" data-stat="approvals">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-warning-lt me-3"><i class="bi bi-check2-square"></i></span>
                    <div>
                        <div class="fw-bold fs-3 dash-counter" id="statApprovals">—</div>
                        <div class="text-secondary small">Pending Approvals</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 col-xl">
        <div class="card card-sm dash-stat-card" data-stat="notifications">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-info-lt me-3"><i class="bi bi-bell"></i></span>
                    <div>
                        <div class="fw-bold fs-3 dash-counter" id="statNotifications">—</div>
                        <div class="text-secondary small">Notifications</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 col-xl">
        <div class="card card-sm dash-stat-card" data-stat="alerts">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-danger-lt me-3"><i class="bi bi-exclamation-triangle"></i></span>
                    <div>
                        <div class="fw-bold fs-3 dash-counter" id="statAlerts">—</div>
                        <div class="text-secondary small">Alerts</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 col-xl">
        <div class="card card-sm dash-stat-card" data-stat="attendance">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-success-lt me-3"><i class="bi bi-clock-history"></i></span>
                    <div>
                        <div class="fw-bold fs-3 dash-counter" id="statAttendance">—</div>
                        <div class="text-secondary small">Attendance</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Department Quick Access ═══ -->
@if (Model.CanViewAllDepts)
{
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-grid-3x3-gap me-2"></i>Department Quick Access</h3>
    </div>
    <div class="card-body">
        <div class="row g-2" id="deptQuickAccess">
            @{
                var depts = new[]
                {
                    ("MGT", "Top Management", "bi-briefcase", "primary"),
                    ("ADM", "Administration", "bi-building", "azure"),
                    ("HR", "Human Resource", "bi-people", "purple"),
                    ("FIN", "Accounts & Finance", "bi-cash-coin", "green"),
                    ("IT", "IT & ERP Support", "bi-pc-display", "cyan"),
                    ("SAL", "Sales & Marketing", "bi-graph-up-arrow", "orange"),
                    ("CST", "Customer Service", "bi-headset", "pink"),
                    ("EST", "Estimation & Costing", "bi-calculator", "yellow"),
                    ("PRE", "Pre-Press & Design", "bi-palette", "indigo"),
                    ("PRT", "Printing", "bi-printer", "red"),
                    ("FINP", "Post-Press", "bi-scissors", "teal"),
                    ("PKG", "Packaging", "bi-box-seam", "lime"),
                    ("DSP", "Dispatch", "bi-truck", "blue"),
                    ("INV", "Inventory", "bi-archive", "dark"),
                    ("PUR", "Purchase", "bi-cart3", "orange"),
                    ("QMS", "Quality", "bi-shield-check", "success"),
                    ("MNT", "Maintenance", "bi-wrench-adjustable", "warning"),
                    ("SEC", "Security", "bi-lock", "danger")
                };
            }
            @foreach (var (code, name, icon, color) in depts)
            {
                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                    <a href="/Dashboard/@code" class="card card-sm dash-dept-card text-decoration-none @(code == Model.DeptCode ? "dash-dept-active" : "")">
                        <div class="card-body text-center py-3">
                            <span class="avatar avatar-sm bg-@(color)-lt mb-2">
                                <i class="bi @icon"></i>
                            </span>
                            <div class="fw-semibold small">@code</div>
                            <div class="text-secondary" style="font-size:.7rem;">@name</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
}

<!-- ═══ HRMS My Status ═══ -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card dash-hrms-card">
            <div class="card-header">
