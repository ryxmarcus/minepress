@page
@model erp.minepress.web.Pages.Accounting.JournalVoucher.IndexModel
@{
    ViewData["Title"] = "Journal Vouchers";
}

<div class="acc-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto"><span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);"><i class="bi bi-journal-text" style="font-size:1.5rem;"></i></span></div>
        <div class="col"><h2 class="mb-0">Journal Vouchers</h2><div class="text-white-75">General ledger journal entries &amp; adjustments</div></div>
        <div class="col-auto d-flex gap-2">
            <a href="/Accounting" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
            <button class="btn btn-outline-light btn-sm" onclick="loadList()"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
        </div>
    </div>
</div>

<div class="acc-sub-nav d-print-none mb-3">
    <a href="/Accounting/JournalVoucher" class="acc-sub-nav-item active"><i class="bi bi-journal-text me-1"></i>Journals</a>
    <a href="/Accounting/ExpenseVoucher" class="acc-sub-nav-item"><i class="bi bi-cash-coin me-1"></i>Expenses</a>
    <a href="/Accounting/BankReconciliation" class="acc-sub-nav-item"><i class="bi bi-bank me-1"></i>Reconciliation</a>
</div>

<div class="card mb-3"><div class="card-body py-2"><div class="row g-2 align-items-center">
    <div class="col-md-4"><div class="input-icon"><span class="input-icon-addon"><i class="bi bi-search"></i></span><input type="text" id="txtSearch" class="form-control form-control-sm" placeholder="Search journal no, narration..." /></div></div>
    <div class="col-md-2"><select id="ddlStatus" class="form-select form-select-sm"><option value="">All</option><option value="DRAFT">Draft</option><option value="POSTED">Posted</option><option value="CANCELLED">Cancelled</option></select></div>
    <div class="col-md-2"><select id="ddlType" class="form-select form-select-sm"><option value="">All Types</option><option value="GENERAL">General</option><option value="ADJUSTMENT">Adjustment</option><option value="OPENING">Opening</option><option value="CLOSING">Closing</option></select></div>
</div></div></div>

<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table table-hover acc-list-table">
    <thead><tr><th>Journal No</th><th>Date</th><th>Type</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th>Narration</th><th>Source</th><th>Status</th></tr></thead>
    <tbody id="listBody"><tr><td colspan="8" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr></tbody>
</table></div></div>

@section Scripts {
    <script>
        let allData = [];
        $(document).ready(function () { loadList(); $('#txtSearch, #ddlStatus, #ddlType').on('input change', applyFilters); });
        function loadList() {
            $.get('/api/accounting/journal-vouchers', function (data) { allData = data; applyFilters(); })
            .fail(function () { $('#listBody').html('<tr><td colspan="8" class="text-center text-danger py-3">Failed to load.</td></tr>'); });
        }
        function applyFilters() {
            const q = ($('#txtSearch').val() || '').toLowerCase(), st = $('#ddlStatus').val(), tp = $('#ddlType').val();
            let f = allData.filter(i => {
                if (q && !(i.journalNo || '').toLowerCase().includes(q) && !(i.narration || '').toLowerCase().includes(q)) return false;
                if (st && i.status !== st) return false;
                if (tp && i.journalType !== tp) return false;
                return true;
            });
            let html = '';
            if (!f.length) html = '<tr><td colspan="8" class="text-center text-muted py-4">No journal vouchers found</td></tr>';
            f.forEach(i => {
                const sc = { 'DRAFT': 'acc-status-draft', 'POSTED': 'acc-status-posted', 'CANCELLED': 'acc-status-cancelled' }[i.status] || 'bg-secondary-lt';
                const auto = i.isAutoGenerated ? '<i class="bi bi-robot text-azure ms-1" title="Auto-generated"></i>' : '';
                html += `<tr><td class="fw-semibold">${esc(i.journalNo)}${auto}</td><td class="text-muted small">${esc(i.journalDate)}</td><td class="small">${esc((i.journalType || '').replace(/_/g, ' '))}</td><td class="text-end fw-semibold">${fmt(i.totalDebit)}</td><td class="text-end fw-semibold">${fmt(i.totalCredit)}</td><td class="small text-truncate" style="max-width:200px;" title="${esc(i.narration)}">${esc(i.narration || '-')}</td><td class="small">${esc(i.sourceVoucherNo || '-')}</td><td><span class="acc-status-badge ${sc}">${(i.status || '').replace(/_/g, ' ')}</span></td></tr>`;
            });
            $('#listBody').html(html);
        }
        function fmt(v) { return v != null ? '₹' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '₹0.00'; }
        function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.appendChild(document.createTextNode(s)); return d.innerHTML; }
    </script>
}
