@*
    Shared Customer Search Component — reusable across Enquiry, Quotation, Job pages.
    Usage: <partial name="_CustomerSearchPartial" />
    Requires: jQuery, Bootstrap 5. Exposes: CustomerSearch.init(options)
*@

<div id="customerSearchWidget">
    <div class="cs-search-wrap">
        <i class="bi bi-search cs-search-icon"></i>
        <input type="text" id="csSearchInput" class="form-control form-control-sm"
               placeholder="Search by name, code, mobile or GST..." autocomplete="off" />
        <span id="csSearchSpinner" class="spinner-border spinner-border-sm cs-spinner d-none"></span>
    </div>

    <!-- Selected customer badge -->
    <div id="csSelectedBadge" class="cs-selected d-none">
        <div class="d-flex align-items-center gap-2">
            <span class="cs-avatar" id="csSelAvatar"></span>
            <div class="flex-fill cs-sel-body">
                <div class="fw-semibold cs-sel-name" id="csSelName"></div>
                <div class="cs-sel-meta">
                    <span class="badge bg-primary-lt me-1" id="csSelCode"></span>
                    <span class="text-secondary" id="csSelGst"></span>
                </div>
                <div class="cs-sel-contact">
                    <span><i class="bi bi-envelope me-1"></i><span id="csSelEmail"></span></span>
                    <span class="ms-2"><i class="bi bi-phone me-1"></i><span id="csSelMobile"></span></span>
                </div>
            </div>
            <button type="button" class="btn btn-ghost-secondary btn-sm btn-icon cs-clear-btn flex-shrink-0" id="csClearBtn" title="Clear">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- Dropdown results -->
    <div id="csDropdown" class="cs-dropdown d-none">
        <div id="csResults" class="cs-results"></div>
        <div id="csNoResult" class="cs-no-result d-none">
            <i class="bi bi-search"></i>
            <span>No customers found</span>
        </div>
        <div id="csLoadMore" class="cs-load-more d-none">
            <button type="button" class="btn btn-ghost-primary btn-sm w-100" id="csLoadMoreBtn">Load more…</button>
        </div>
    </div>
    <input type="hidden" id="csPartyId" value="" />
</div>
