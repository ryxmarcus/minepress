@page
@model erp.minepress.web.Pages.DbManager.IndexModel
@{
    ViewData["Title"] = "Database Manager";
    ViewData["ContainerClass"] = "container-fluid px-3";
}

@section Styles {
    <link href="/css/db-manager.css" rel="stylesheet" />
}

<!-- ═══════════ HERO ═══════════ -->
<div class="dbm-hero">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-database-gear" style="font-size:1.5rem;"></i>
            </span>
            <div>
                <h2 class="mb-0 text-white fw-bold">Database Manager</h2>
                <div class="text-white-75">Browse, edit, insert & delete records — with full referential integrity</div>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-danger-lt text-white"><i class="bi bi-shield-lock me-1"></i>Admin Only</span>
            <button class="btn btn-outline-light btn-sm" onclick="DBM.refreshCurrentTable()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- ═══════════ STATS ROW ═══════════ -->
<div class="row g-3 mb-3" id="dbmStatsRow">
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-primary-lt me-3"><i class="bi bi-table"></i></span>
                    <div>
                        <div class="fw-bold" id="dbmStatTables">0</div>
                        <div class="text-secondary small">Tables</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-azure-lt me-3"><i class="bi bi-eye"></i></span>
                    <div>
                        <div class="fw-bold" id="dbmStatViews">0</div>
                        <div class="text-secondary small">Views</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-success-lt me-3"><i class="bi bi-columns-gap"></i></span>
                    <div>
                        <div class="fw-bold" id="dbmStatCols">—</div>
                        <div class="text-secondary small">Columns</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-warning-lt me-3"><i class="bi bi-list-ol"></i></span>
                    <div>
                        <div class="fw-bold" id="dbmStatRows">—</div>
                        <div class="text-secondary small">Rows</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ MAIN LAYOUT ═══════════ -->
<div class="dbm-workspace">
    <!-- ── Left Sidebar: Table Browser ── -->
    <div class="dbm-sidebar" id="dbmSidebar">
        <div class="dbm-sidebar-header">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-diagram-3 text-primary"></i>
                <span class="fw-bold small">Schema Explorer</span>
            </div>
            <input type="text" class="form-control form-control-sm dbm-search" id="dbmTableSearch"
                   placeholder="Search tables…" autocomplete="off">
        </div>
        <div class="dbm-table-tree" id="dbmTableTree">
            <div class="text-center py-4 text-muted small">
                <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                <div>Loading schema…</div>
            </div>
        </div>
    </div>

    <!-- ── Main Content ── -->
    <div class="dbm-main">
        <!-- Empty state -->
        <div class="dbm-empty" id="dbmEmpty">
            <div class="dbm-empty-icon">
                <i class="bi bi-database"></i>
            </div>
            <h3>Select a Table</h3>
            <p class="text-muted">Choose a table from the sidebar to browse and manage its data.</p>
        </div>

        <!-- Data Panel -->
        <div class="dbm-data-panel" id="dbmDataPanel" style="display:none;">
            <!-- Toolbar -->
            <div class="dbm-toolbar">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="dbm-table-badge" id="dbmTableBadge">
                        <i class="bi bi-table me-1"></i><span id="dbmActiveTable">—</span>
                    </div>
                    <span class="badge bg-secondary-lt" id="dbmRowCountBadge">0 rows</span>
                    <span class="badge bg-primary-lt" id="dbmTypeBadge">table</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="input-group input-group-sm" style="width:220px;">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="dbmDataSearch" placeholder="Search data…" autocomplete="off">
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-success" id="dbmBtnInsert" onclick="DBM.showInsertModal()" title="Insert Row">
                            <i class="bi bi-plus-lg me-1"></i>Insert
                        </button>
                        <button class="btn btn-outline-secondary" onclick="DBM.refreshCurrentTable()" title="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <select class="form-select form-select-sm" id="dbmPageSize" style="width:80px;">
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                </div>
            </div>

            <!-- Data Grid -->
            <div class="dbm-grid-wrapper" id="dbmGridWrapper">
                <div class="table-responsive">
                    <table class="table table-hover dbm-table" id="dbmDataTable">
                        <thead id="dbmTableHead"></thead>
                        <tbody id="dbmTableBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <div class="dbm-pagination" id="dbmPagination">
                <div class="text-muted small" id="dbmPageInfo">Showing 0–0 of 0</div>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary" id="dbmBtnFirst" onclick="DBM.goToPage(1)"><i class="bi bi-chevron-double-left"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" id="dbmBtnPrev" onclick="DBM.prevPage()"><i class="bi bi-chevron-left"></i></button>
                    <span class="dbm-page-display" id="dbmPageDisplay">1 / 1</span>
                    <button class="btn btn-sm btn-outline-secondary" id="dbmBtnNext" onclick="DBM.nextPage()"><i class="bi bi-chevron-right"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" id="dbmBtnLast" onclick="DBM.goToPage(-1)"><i class="bi bi-chevron-double-right"></i></button>
                </div>
            </div>
        </div>

        <!-- Column / Structure Panel (toggled) -->
        <div class="dbm-structure-panel" id="dbmStructurePanel" style="display:none;">
            <div class="dbm-toolbar">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-columns-gap text-primary"></i>
                    <span class="fw-bold">Table Structure</span>
                </div>
                <button class="btn btn-sm btn-outline-secondary" onclick="DBM.showDataView()">
                    <i class="bi bi-grid-3x3 me-1"></i>Data View
                </button>
            </div>
            <div class="table-responsive p-3">
                <table class="table table-sm table-bordered dbm-structure-table">
                    <thead>
                        <tr>
                            <th style="width:30px;"></th>
                            <th>Column</th>
                            <th>Type</th>
                            <th>Nullable</th>
                            <th>Default</th>
                            <th>Comment</th>
                        </tr>
                    </thead>
                    <tbody id="dbmStructureBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ INSERT / EDIT MODAL ═══════════ -->
<div class="modal fade" id="dbmRowModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content dbm-modal">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary fs-4"></i>
                    <h5 class="modal-title" id="dbmRowModalTitle">Insert Row</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="dbmRowModalBody">
                <!-- Dynamic form fields -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="dbmBtnSaveRow" onclick="DBM.saveRow()">
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ DELETE CONFIRM MODAL ═══════════ -->
<div class="modal fade" id="dbmDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content dbm-modal">
            <div class="modal-header bg-danger text-white">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="dbmDeleteBody">
                <p>Are you sure you want to delete this row?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="dbmBtnConfirmDelete" onclick="DBM.confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ FK REFERENCES MODAL ═══════════ -->
<div class="modal fade" id="dbmRefModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content dbm-modal">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-diagram-2 text-info fs-4"></i>
                    <h5 class="modal-title">References</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="dbmRefBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/db-manager.js"></script>
}
