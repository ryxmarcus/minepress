@page
@model erp.minepress.web.Pages.Store.IndexModel
@{
    ViewData["Title"] = "Store Dashboard";
}

<!-- Hero Header -->
<div class="store-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-box-seam" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Store Dashboard</h2>
            <div class="text-white-75">Manage store issues, receives, purchases, and stock ledger.</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="loadDashboardStats()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-3" id="dashStats">
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-primary-lt me-3"><i class="bi bi-box-arrow-up"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statTotalIssues">0</div>
                        <div class="text-secondary small">Total Issues</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-success-lt me-3"><i class="bi bi-box-arrow-in-down"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statTotalReceives">0</div>
                        <div class="text-secondary small">Total Receives</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-warning-lt me-3"><i class="bi bi-pencil-square"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statDraftIssues">0</div>
                        <div class="text-secondary small">Draft Issues</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-danger-lt me-3"><i class="bi bi-exclamation-triangle"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statLowStock">0</div>
                        <div class="text-secondary small">Low Stock Items</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="bi bi-box-arrow-up fs-1 text-primary mb-2"></i>
                <h4 class="mb-1">Store Issue</h4>
                <p class="text-muted small mb-3">Issue materials against jobs, transfers, or adjustments.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a href="/Store/Issue" class="btn btn-outline-primary btn-sm"><i class="bi bi-list-ul me-1"></i>View List</a>
                    <a href="/Store/Issue/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Issue</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="bi bi-box-arrow-in-down fs-1 text-success mb-2"></i>
                <h4 class="mb-1">Store Receive</h4>
                <p class="text-muted small mb-3">Receive materials from purchases, returns, or adjustments.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a href="/Store/Receive" class="btn btn-outline-success btn-sm"><i class="bi bi-list-ul me-1"></i>View List</a>
                    <a href="/Store/Receive/Create" class="btn btn-success btn-sm"><i class="bi bi-plus-lg me-1"></i>New Receive</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="bi bi-box-seam fs-1 text-info mb-2"></i>
                <h4 class="mb-1">Purchase GRN</h4>
                <p class="text-muted small mb-3">Create Goods Receipt Notes for purchased materials.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a href="/Store/Purchase" class="btn btn-outline-info btn-sm"><i class="bi bi-list-ul me-1"></i>View List</a>
                    <a href="/Store/Purchase/Create" class="btn btn-info btn-sm"><i class="bi bi-plus-lg me-1"></i>New GRN</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="bi bi-journal-text fs-1 text-teal mb-2"></i>
                <h4 class="mb-1">Stock Ledger</h4>
                <p class="text-muted small mb-3">View all stock movements across materials.</p>
                <a href="/Store/StockLedger" class="btn btn-outline-teal btn-sm"><i class="bi bi-journal-text me-1"></i>View Stock Ledger</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () { loadDashboardStats(); });

        function loadDashboardStats() {
            $.get('/api/store/dashboard-stats', function (d) {
                $('#statTotalIssues').text(d.totalIssues);
                $('#statTotalReceives').text(d.totalReceives);
                $('#statDraftIssues').text(d.draftIssues);
                $('#statLowStock').text(d.lowStockItems);
            });
        }
    </script>
}
