@page
@model erp.minepress.web.Pages.Store.StockLedger.IndexModel
@{
    ViewData["Title"] = "Stock Ledger";
}

<!-- Hero Header -->
<div class="store-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-journal-text" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Stock Ledger</h2>
            <div class="text-white-75">View all stock movements — issues, receives, and GRN entries.</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" id="btnRefresh" onclick="activeTab==='ledger'?loadLedger():loadCurrentStock()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="stockTabs">
    <li class="nav-item">
        <a class="nav-link active" href="#" id="tabLedger" onclick="switchTab('ledger');return false;">
            <i class="bi bi-journal-text me-1"></i>Transactions
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" id="tabCurrentStock" onclick="switchTab('stock');return false;">
            <i class="bi bi-boxes me-1"></i>Current Stock
        </a>
    </li>
</ul>

<!-- Filters -->
<div id="ledgerPanel">
<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                    <input type="text" id="txtSearch" class="form-control form-control-sm" placeholder="Search material, code, reference..." />
                </div>
            </div>
            <div class="col-md-2">
                <select id="ddlCategoryFilter" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="ddlTypeFilter" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="ISSUE">Issue</option>
                    <option value="RECEIVE">Receive</option>
                    <option value="GRN">GRN</option>
                </select>
            </div>
            <div class="col-auto ms-auto">
                <span class="text-muted small" id="filteredCount"></span>
            </div>
        </div>
    </div>
</div>

<!-- Ledger Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table store-list-table table-hover">
            <thead>
                <tr>
                    <th class="sortable" data-sort="transactionDate" style="cursor:pointer;">Date <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Category</th>
                    <th>Material</th>
                    <th>UOM</th>
                    <th class="text-center sortable" data-sort="quantityIn" style="cursor:pointer;">Qty In <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th class="text-center sortable" data-sort="quantityOut" style="cursor:pointer;">Qty Out <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th class="text-center">Balance</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Amount</th>
                    <th>Job No</th>
                </tr>
            </thead>
            <tbody id="ledgerBody">
                <tr><td colspan="12" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Paging Controls -->
<div class="card mt-2" id="pagingControls" style="display:none;">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Show</span>
                <select id="ddlPageSize" class="form-select form-select-sm" style="width:auto;">
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="250">250</option>
                </select>
                <span class="text-muted small">entries</span>
            </div>
            <div class="text-muted small" id="pagingInfo"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="paginationNav"></ul></nav>
        </div>
    </div>
</div>

<div id="emptyState" class="text-center py-5" style="display:none;">
    <i class="bi bi-journal-text" style="font-size:3rem; opacity:.3;"></i>
    <div class="text-muted mt-2">No stock ledger entries found</div>
</div>
</div><!-- end #ledgerPanel -->

<!-- ══ Current Stock Panel ══ -->
<div id="currentStockPanel" style="display:none;">
    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                        <input type="text" id="csSearch" class="form-control form-control-sm" placeholder="Search item name or code..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <select id="csGroupFilter" class="form-select form-select-sm">
                        <option value="">All Groups</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select id="csStockFilter" class="form-select form-select-sm">
                        <option value="">All Stock Status</option>
                        <option value="in">In Stock</option>
                        <option value="low">Low Stock</option>
                        <option value="out">Out of Stock</option>
                    </select>
                </div>
                <div class="col-auto ms-auto">
                    <span class="text-muted small" id="csResultCount"></span>
                </div>
            </div>
        </div>
    </div>
    <!-- Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table store-list-table table-hover">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Item Name</th>
                        <th>Group</th>
                        <th>UOM</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Current Stock</th>
                        <th class="text-end">Reorder Level</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Stock Value</th>
                    </tr>
                </thead>
                <tbody id="csTableBody">
                    <tr><td colspan="9" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Paging -->
    <div class="card mt-2" id="csPagingControls" style="display:none;">
        <div class="card-body py-2">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Show</span>
                    <select id="csPageSize" class="form-select form-select-sm" style="width:auto;">
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="text-muted small">entries</span>
                </div>
                <div class="text-muted small" id="csPagingInfo"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="csPaginationNav"></ul></nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/store.js"></script>
    <script>
        const API_BASE = '/api/store';
        let allItems = [];
        let currentPage = 1, pageSize = 50, sortField = 'transactionDate', sortDir = 'desc';

        $(document).ready(function () {
            loadLedger();
            $('#txtSearch, #ddlCategoryFilter, #ddlTypeFilter').on('input change', function () { currentPage = 1; applyFilters(); });
            $('#ddlPageSize').on('change', function () { pageSize = parseInt($(this).val()); currentPage = 1; applyFilters(); });
            $(document).on('click', '.sortable', function () {
                const field = $(this).data('sort');
                if (sortField === field) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                else { sortField = field; sortDir = 'asc'; }
                $('.sortable i').attr('class', 'bi bi-arrow-down-up small text-muted');
                $(this).find('i').attr('class', sortDir === 'asc' ? 'bi bi-arrow-up small text-primary' : 'bi bi-arrow-down small text-primary');
                applyFilters();
            });
        });

        function loadLedger() {
            $('#ledgerBody').html('<tr><td colspan="12" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>');
            $.get(`${API_BASE}/stock-ledger`, function (data) {
                allItems = data;
                populateCategories();
                applyFilters();
            }).fail(function () {
                $('#ledgerBody').html('<tr><td colspan="12" class="text-center text-danger py-3"><i class="bi bi-exclamation-circle me-1"></i>Failed to load.</td></tr>');
            });
        }

        function populateCategories() {
            const cats = [...new Set(allItems.map(e => e.materialCategory).filter(Boolean))].sort();
            const ddl = $('#ddlCategoryFilter');
            const current = ddl.val();
            ddl.find('option:not(:first)').remove();
            cats.forEach(c => ddl.append(`<option value="${c}">${c}</option>`));
            if (current) ddl.val(current);
        }

        function applyFilters() {
            const q = ($('#txtSearch').val() || '').toLowerCase();
            const category = $('#ddlCategoryFilter').val();
            const type = $('#ddlTypeFilter').val();
            let filtered = allItems.filter(e => {
                if (q && !(e.materialName || '').toLowerCase().includes(q) && !(e.materialCode || '').toLowerCase().includes(q) && !(e.referenceNo || '').toLowerCase().includes(q)) return false;
                if (category && e.materialCategory !== category) return false;
                if (type && e.transactionType !== type) return false;
                return true;
            });
            filtered.sort((a, b) => {
                let va = a[sortField] ?? '', vb = b[sortField] ?? '';
                if (typeof va === 'string') va = va.toLowerCase();
                if (typeof vb === 'string') vb = vb.toLowerCase();
                return va < vb ? (sortDir === 'asc' ? -1 : 1) : va > vb ? (sortDir === 'asc' ? 1 : -1) : 0;
            });
            const total = filtered.length, totalPages = Math.max(1, Math.ceil(total / pageSize));
            if (currentPage > totalPages) currentPage = totalPages;
            const start = (currentPage - 1) * pageSize;
            const paged = filtered.slice(start, start + pageSize);
            $('#filteredCount').text(filtered.length < allItems.length ? `Showing ${filtered.length} of ${allItems.length}` : '');
            renderTable(paged);
            StoreUtils.renderPaging(total, totalPages, currentPage, pageSize, p => { currentPage = p; applyFilters(); });
        }

        function renderTable(data) {
            if (!data.length) { $('#ledgerBody').html(''); $('#emptyState').show(); return; }
            $('#emptyState').hide();
            let html = '';
            data.forEach(e => {
                const typeBadge = e.transactionType === 'ISSUE' ? 'bg-orange-lt' : e.transactionType === 'RECEIVE' ? 'bg-green-lt' : 'bg-azure-lt';
                html += `<tr>
                    <td>${esc(e.transactionDate)}</td>
                    <td><span class="badge ${typeBadge}">${e.transactionType}</span></td>
                    <td><span class="fw-semibold">${esc(e.referenceNo || '-')}</span><div class="text-muted small">${e.referenceType || ''}</div></td>
                    <td><span class="badge bg-green-lt">${esc(e.materialCategory || '-')}</span></td>
                    <td>${esc(e.materialName)}<div class="text-muted small">${esc(e.materialCode || '')}</div></td>
                    <td>${esc(e.uom || 'Pcs')}</td>
                    <td class="text-center">${e.quantityIn ? `<span class="text-success fw-bold">+${e.quantityIn}</span>` : '-'}</td>
                    <td class="text-center">${e.quantityOut ? `<span class="text-danger fw-bold">-${e.quantityOut}</span>` : '-'}</td>
                    <td class="text-center fw-bold">${e.balanceQuantity ?? '-'}</td>
                    <td class="text-end">${(e.rate || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                    <td class="text-end fw-bold">${(e.amount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                    <td>${esc(e.jobNo || '-')}</td>
                </tr>`;
            });
            $('#ledgerBody').html(html);
        }

        function esc(v) { return (v || '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;'); }

        // ── Tab switching ──
        let activeTab = 'ledger';
        function switchTab(tab) {
            activeTab = tab;
            if (tab === 'ledger') {
                $('#tabLedger').addClass('active');
                $('#tabCurrentStock').removeClass('active');
                $('#ledgerPanel').show();
                $('#currentStockPanel').hide();
            } else {
                $('#tabCurrentStock').addClass('active');
                $('#tabLedger').removeClass('active');
                $('#ledgerPanel').hide();
                $('#currentStockPanel').show();
                if (!csLoaded) loadCurrentStock();
            }
        }

        // ── Current Stock ──
        let csLoaded = false, csPage = 1, csPageSize = 50, csTotal = 0;

        function loadCurrentStock() {
            $('#csTableBody').html('<tr><td colspan="9" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading...</td></tr>');
            $.getJSON(`${API_BASE}/stock/current`, {
                group: $('#csGroupFilter').val() || '',
                q: $('#csSearch').val() || '',
                page: csPage,
                pageSize: csPageSize
            }, function (data) {
                csTotal = data.totalCount;
                csLoaded = true;
                // Populate group filter once
                const $gf = $('#csGroupFilter');
                if ($gf.find('option').length <= 1) {
                    (data.groups || []).forEach(g => $gf.append(`<option value="${esc(g)}">${esc(g)}</option>`));
                }
                renderCurrentStockTable(data.items);
                renderCurrentStockPaging(data.totalCount, data.page, data.pageSize);
            }).fail(function () {
                $('#csTableBody').html('<tr><td colspan="9" class="text-center text-danger py-3"><i class="bi bi-exclamation-circle me-1"></i>Failed to load.</td></tr>');
            });
        }

        function renderCurrentStockTable(items) {
            const stockFilter = $('#csStockFilter').val();
            let filtered = items;
            if (stockFilter === 'in') filtered = items.filter(i => i.isInStock && !i.isLowStock);
            else if (stockFilter === 'low') filtered = items.filter(i => i.isLowStock);
            else if (stockFilter === 'out') filtered = items.filter(i => i.isOutOfStock);

            $('#csResultCount').text(filtered.length !== items.length ? `${filtered.length} of ${items.length}` : `${csTotal.toLocaleString()} item(s)`);

            if (!filtered.length) {
                $('#csTableBody').html('<tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-boxes me-2"></i>No items found</td></tr>');
                return;
            }

            let html = '';
            filtered.forEach(i => {
                let statusBadge;
                if (i.isOutOfStock)       statusBadge = '<span class="badge bg-red-lt text-danger"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>';
                else if (i.isLowStock)    statusBadge = '<span class="badge bg-orange-lt text-orange"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</span>';
                else                      statusBadge = '<span class="badge bg-green-lt text-green"><i class="bi bi-check-circle me-1"></i>In Stock</span>';

                const stockClass = i.isOutOfStock ? 'text-danger fw-bold' : i.isLowStock ? 'text-warning fw-bold' : 'text-success fw-bold';
                const stockValue = (i.currentStock * i.purchaseRate).toLocaleString('en-IN', { minimumFractionDigits: 2 });

                html += `<tr>
                    <td><span class="badge bg-azure-lt fw-normal">${esc(i.itemCode)}</span></td>
                    <td><div class="fw-semibold">${esc(i.itemName)}</div><small class="text-muted">${esc(i.itemCategory || '')}</small></td>
                    <td><span class="badge bg-secondary-lt">${esc(i.itemGroup)}</span></td>
                    <td>${esc(i.uom)}</td>
                    <td class="text-center">${statusBadge}</td>
                    <td class="text-end ${stockClass}">${i.currentStock.toLocaleString('en-IN')}</td>
                    <td class="text-end text-muted">${i.reorderLevel.toLocaleString('en-IN')}</td>
                    <td class="text-end">${i.purchaseRate.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td class="text-end fw-semibold">${stockValue}</td>
                </tr>`;
            });
            $('#csTableBody').html(html);
        }

        function renderCurrentStockPaging(total, page, pageSize) {
            const totalPages = Math.max(1, Math.ceil(total / pageSize));
            const start = total === 0 ? 0 : (page - 1) * pageSize + 1;
            const end = Math.min(page * pageSize, total);
            $('#csPagingInfo').text(total > 0 ? `${start}–${end} of ${total.toLocaleString()}` : '');
            $('#csPagingControls').toggle(totalPages > 1);
            if (totalPages <= 1) { $('#csPaginationNav').html(''); return; }

            let html = '';
            html += `<li class="page-item ${page <= 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" data-cspage="${page - 1}">&laquo;</a></li>`;
            const sp = Math.max(1, page - 3), ep = Math.min(totalPages, page + 3);
            if (sp > 1) { html += `<li class="page-item"><a class="page-link" href="javascript:void(0)" data-cspage="1">1</a></li>`; if (sp > 2) html += `<li class="page-item disabled"><span class="page-link">&hellip;</span></li>`; }
            for (let i = sp; i <= ep; i++) html += `<li class="page-item ${i === page ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" data-cspage="${i}">${i}</a></li>`;
            if (ep < totalPages) { if (ep < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">&hellip;</span></li>`; html += `<li class="page-item"><a class="page-link" href="javascript:void(0)" data-cspage="${totalPages}">${totalPages}</a></li>`; }
            html += `<li class="page-item ${page >= totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" data-cspage="${page + 1}">&raquo;</a></li>`;
            const $nav = $('#csPaginationNav');
            $nav.html(html);
            $nav.off('click', '.page-link').on('click', '.page-link', function (e) {
                e.preventDefault();
                const $li = $(this).closest('.page-item');
                if ($li.hasClass('disabled') || $li.hasClass('active')) return;
                csPage = parseInt($(this).data('cspage'));
                loadCurrentStock();
            });
        }

        $(document).ready(function () {
            // Wrap ledger content in a panel div (via JS)
            $('#csSearch, #csGroupFilter').on('input change', function () { csPage = 1; loadCurrentStock(); });
            $('#csStockFilter').on('change', function () {
                // Client-side filter on already-loaded page
                $.getJSON(`${API_BASE}/stock/current`, { group: $('#csGroupFilter').val() || '', q: $('#csSearch').val() || '', page: csPage, pageSize: csPageSize }, function (data) {
                    renderCurrentStockTable(data.items);
                });
            });
            $('#csPageSize').on('change', function () { csPageSize = parseInt($(this).val()); csPage = 1; loadCurrentStock(); });
        });
    </script>
}
