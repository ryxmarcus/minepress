@page
@model erp.minepress.web.Pages.Hrms.Advance.IndexModel
@{
    ViewData["Title"] = "Salary Advance — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-cash-stack" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Salary Advance</h2>
            <div class="text-white-75">View your salary advance requests and repayment status</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="Hrms.loadAdvances()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <a href="/Hrms/Advance/Apply" class="btn btn-light">
                <i class="bi bi-plus-lg me-1"></i>Request Advance
            </a>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-3" id="advanceSummaryCards">
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-purple" id="advPendingCount">—</div>
                <div class="text-secondary small">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-success" id="advApprovedCount">—</div>
                <div class="text-secondary small">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-primary" id="advTotalAmount">—</div>
                <div class="text-secondary small">Total Advance</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-warning" id="advBalanceAmount">—</div>
                <div class="text-secondary small">Balance Due</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Advance No</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Repayment Months</th>
                    <th>Monthly Deduction</th>
                    <th>Balance</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="advanceTableBody">
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Hrms.loadAdvances());
    </script>
}
