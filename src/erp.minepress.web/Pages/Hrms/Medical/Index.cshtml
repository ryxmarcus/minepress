@page
@model erp.minepress.web.Pages.Hrms.Medical.IndexModel
@{
    ViewData["Title"] = "Medical Claims — HRMS";
}

<div class="hrms-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-heart-pulse" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Medical Claims</h2>
            <div class="text-white-75">View and submit medical reimbursement claims</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="Hrms.loadMedical()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <a href="/Hrms/Medical/Submit" class="btn btn-light">
                <i class="bi bi-plus-lg me-1"></i>New Claim
            </a>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-info" id="medTotalClaims">—</div>
                <div class="text-secondary small">Total Claims</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-warning" id="medPendingClaims">—</div>
                <div class="text-secondary small">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-primary" id="medClaimedAmount">—</div>
                <div class="text-secondary small">Total Claimed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card hrms-stat-card">
            <div class="card-body text-center">
                <div class="fw-bold fs-2 text-success" id="medApprovedAmount">—</div>
                <div class="text-secondary small">Total Approved</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Claim No</th>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Relation</th>
                    <th>Hospital</th>
                    <th>Claimed</th>
                    <th>Approved</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="medicalTableBody">
                <tr>
                    <td colspan="8" class="text-center text-secondary py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="/js/hrms.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => Hrms.loadMedical());
    </script>
}
