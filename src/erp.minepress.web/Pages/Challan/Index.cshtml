@page
@model erp.minepress.web.Pages.Challan.IndexModel
@{
    ViewData["Title"] = "Challans";
}

<!-- Hero Header -->
<div class="ch-hero d-print-none">
    <div class="row align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-lg" style="background:rgba(255,255,255,.15);">
                <i class="bi bi-truck" style="font-size:1.5rem;"></i>
            </span>
        </div>
        <div class="col">
            <h2 class="mb-0">Delivery Challans</h2>
            <div class="text-white-75">Manage delivery challans, track dispatches and gate passes.</div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="loadChallanList()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <a href="/Challan/Create" class="btn btn-light">
                <i class="bi bi-plus-lg me-1"></i>New Challan
            </a>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-3" id="chStats">
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-primary-lt me-3"><i class="bi bi-truck"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statTotal">0</div>
                        <div class="text-secondary small">Total</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-warning-lt me-3"><i class="bi bi-plus-circle"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statCreated">0</div>
                        <div class="text-secondary small">Created</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-info-lt me-3"><i class="bi bi-send"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statDispatched">0</div>
                        <div class="text-secondary small">Dispatched</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-success-lt me-3"><i class="bi bi-check-circle"></i></span>
                    <div>
                        <div class="fw-bold fs-3" id="statDelivered">0</div>
                        <div class="text-secondary small">Delivered</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AI Insight Banner -->
<div class="card mb-3 border-0 bg-gradient" id="aiInsightBanner" style="display:none; background: linear-gradient(135deg, rgba(13,110,253,.08), rgba(111,66,193,.08));">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-xs bg-primary-lt"><i class="bi bi-stars"></i></span>
            <span class="small fw-semibold text-primary" id="aiInsightText"></span>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                    <input type="text" id="txtSearch" class="form-control form-control-sm" placeholder="Search challan no, customer, job..." />
                </div>
            </div>
            <div class="col-md-2">
                <select id="ddlStatusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="CREATED">Created</option>
                    <option value="MATERIAL_ISSUED">Material Issued</option>
                    <option value="MATERIAL_RECEIVED">Material Received</option>
                    <option value="OUTSOURCED_SENT">Outsourced Sent</option>
                    <option value="OUTSOURCED_RECEIVED">Outsourced Received</option>
                    <option value="DISPATCHED">Dispatched</option>
                    <option value="DELIVERED">Delivered</option>
                    <option value="CANCELLED">Cancelled</option>
                    <option value="CLOSED">Closed</option>
                </select>
            </div>
            <div class="col-auto ms-auto">
                <span class="text-muted small" id="filteredCount"></span>
            </div>
        </div>
    </div>
</div>

<!-- Challan Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table ch-list-table table-hover">
            <thead>
                <tr>
                    <th class="sortable" data-sort="challanNo" style="cursor:pointer;">Challan No <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th class="sortable" data-sort="challanDate" style="cursor:pointer;">Date <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th class="sortable" data-sort="customerName" style="cursor:pointer;">Customer <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th>Job</th>
                    <th class="text-center">Items</th>
                    <th class="text-end">Total Qty</th>
                    <th>Vehicle</th>
                    <th class="sortable" data-sort="status" style="cursor:pointer;">Status <i class="bi bi-arrow-down-up small text-muted"></i></th>
                    <th class="text-center" style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody id="challanListBody">
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm me-2"></div>Loading challans...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Paging -->
<div class="card mt-2" id="pagingControls" style="display:none;">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Show</span>
                <select id="ddlPageSize" class="form-select form-select-sm" style="width:auto;">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span class="text-muted small">entries</span>
            </div>
            <div class="text-muted small" id="pagingInfo"></div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="paginationNav"></ul>
            </nav>
        </div>
    </div>
</div>
<div id="emptyState" class="text-center py-5" style="display:none;">
    <i class="bi bi-truck" style="font-size:3rem; opacity:.3;"></i>
    <div class="text-muted mt-2">No challans found</div>
    <a href="/Challan/Create" class="btn btn-primary mt-3">
        <i class="bi bi-plus-lg me-1"></i>Create First Challan
    </a>
</div>

<!-- Gate Pass Modal -->
<div class="modal modal-blur fade" id="gatePassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-shield-check me-2 text-success"></i>Issue Gate Pass</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="gpChallanId" />
                <div class="mb-3">
                    <label class="form-label">Vehicle No</label>
                    <input type="text" id="gpVehicleNo" class="form-control" placeholder="e.g. MH-12-AB-1234" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Driver Name</label>
                    <input type="text" id="gpDriverName" class="form-control" placeholder="Driver name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Driver Contact</label>
                    <input type="text" id="gpDriverContact" class="form-control" placeholder="Phone number" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Purpose</label>
                    <input type="text" id="gpPurpose" class="form-control" placeholder="Purpose of gate pass" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <textarea id="gpRemarks" class="form-control" rows="2" placeholder="Any special instructions..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitGatePass()">
                    <i class="bi bi-shield-check me-1"></i>Issue Gate Pass
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const CH_API = '/api/challan';
        let allChallans = [];
        let currentPage = 1;
        let pageSize = 25;
        let sortField = 'challanNo';
        let sortDir = 'desc';

        $(document).ready(function () {
            loadChallanList();
            $('#txtSearch, #ddlStatusFilter').on('input change', function () { currentPage = 1; applyFilters(); });
            $('#ddlPageSize').on('change', function () { pageSize = parseInt($(this).val()); currentPage = 1; applyFilters(); });
            $(document).on('click', '.sortable', function () {
                const field = $(this).data('sort');
                if (sortField === field) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
                else { sortField = field; sortDir = 'asc'; }
                $('.sortable i').attr('class', 'bi bi-arrow-down-up small text-muted');
                $(this).find('i').attr('class', sortDir === 'asc' ? 'bi bi-arrow-up small text-primary' : 'bi bi-arrow-down small text-primary');
                applyFilters();
            });
        });

        function loadChallanList() {
            $('#challanListBody').html('<tr><td colspan="9" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading challans...</td></tr>');
            $.get(`${CH_API}/list`, function (data) {
                allChallans = data;
                updateStats();
                applyFilters();
                showAiInsight();
            }).fail(function () {
                $('#challanListBody').html('<tr><td colspan="9" class="text-center text-danger py-3"><i class="bi bi-exclamation-circle me-1"></i>Failed to load challans.</td></tr>');
            });
        }

        function updateStats() {
            $('#statTotal').text(allChallans.length);
            $('#statCreated').text(allChallans.filter(c => c.status === 'CREATED').length);
            $('#statDispatched').text(allChallans.filter(c => c.status === 'DISPATCHED').length);
            $('#statDelivered').text(allChallans.filter(c => c.status === 'DELIVERED').length);
        }

        function showAiInsight() {
            if (allChallans.length === 0) return;
            const pending = allChallans.filter(c => c.status === 'CREATED' || c.status === 'MATERIAL_ISSUED').length;
            const dispatched = allChallans.filter(c => c.status === 'DISPATCHED').length;
            let msg = '';
            if (pending > 3) msg = `⚡ ${pending} challans pending dispatch — consider batch processing for efficiency.`;
            else if (dispatched > 5) msg = `🚛 ${dispatched} challans in transit — monitor delivery confirmations.`;
            else if (allChallans.length > 0) msg = `📊 ${allChallans.length} total challans tracked. Delivery pipeline is healthy.`;
            if (msg) { $('#aiInsightText').text(msg); $('#aiInsightBanner').show(); }
        }

        function applyFilters() {
            const q = ($('#txtSearch').val() || '').toLowerCase();
            const status = $('#ddlStatusFilter').val();
            let filtered = allChallans.filter(c => {
                if (q && !(c.challanNo || '').toLowerCase().includes(q) &&
                    !(c.customerName || '').toLowerCase().includes(q) &&
                    !(c.jobNo || '').toLowerCase().includes(q)) return false;
                if (status && c.status !== status) return false;
                return true;
            });
            filtered.sort((a, b) => {
                let va = a[sortField], vb = b[sortField];
                if (va == null) va = '';
                if (vb == null) vb = '';
                if (typeof va === 'string') va = va.toLowerCase();
                if (typeof vb === 'string') vb = vb.toLowerCase();
                if (va < vb) return sortDir === 'asc' ? -1 : 1;
                if (va > vb) return sortDir === 'asc' ? 1 : -1;
                return 0;
            });
            const totalItems = filtered.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
            if (currentPage > totalPages) currentPage = totalPages;
            const start = (currentPage - 1) * pageSize;
            const paged = filtered.slice(start, start + pageSize);
            $('#filteredCount').text(filtered.length < allChallans.length ? `Showing ${filtered.length} of ${allChallans.length}` : '');
            renderTable(paged);
            renderPaging(totalItems, totalPages);
        }

        function renderPaging(totalItems, totalPages) {
            if (totalItems === 0) { $('#pagingControls').hide(); return; }
            $('#pagingControls').show();
            const start = (currentPage - 1) * pageSize + 1;
            const end = Math.min(currentPage * pageSize, totalItems);
            $('#pagingInfo').text(`Showing ${start} to ${end} of ${totalItems} entries`);
            let navHtml = '';
            navHtml += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${currentPage - 1})">&laquo;</a></li>`;
            const maxButtons = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
            let endPage = Math.min(totalPages, startPage + maxButtons - 1);
            if (endPage - startPage < maxButtons - 1) startPage = Math.max(1, endPage - maxButtons + 1);
            for (let i = startPage; i <= endPage; i++) {
                navHtml += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${i})">${i}</a></li>`;
            }
            navHtml += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${currentPage + 1})">&raquo;</a></li>`;
            $('#paginationNav').html(navHtml);
        }

        function goToPage(page) { currentPage = page; applyFilters(); }

        function renderTable(data) {
            if (data.length === 0) { $('#challanListBody').html(''); $('#emptyState').show(); return; }
            $('#emptyState').hide();
            let html = '';
            data.forEach(c => {
                const statusClass = getStatusClass(c.status);
                const isClosed = c.status === 'DELIVERED' || c.status === 'CANCELLED' || c.status === 'CLOSED';
                const isCreated = c.status === 'CREATED';

                html += `<tr class="ch-list-row">
                    <td>
                        <a href="/Challan/Details?id=${c.challanId}" class="fw-semibold text-primary text-decoration-none">${esc(c.challanNo)}</a>
                        <div class="text-muted small">${c.createdOn || ''}</div>
                    </td>
                    <td>${esc(c.challanDate)}</td>
                    <td>
                        <div class="fw-semibold">${esc(c.customerName)}</div>
                        <div class="text-muted small">${esc(c.customerCode || '')}</div>
                    </td>
                    <td><a href="/Job/Details?id=${c.jobId}" class="badge bg-purple-lt text-decoration-none">${esc(c.jobNo)}</a></td>
                    <td class="text-center"><span class="badge bg-primary-lt">${c.itemCount}</span></td>
                    <td class="text-end fw-semibold">${c.totalQty != null ? Number(c.totalQty).toLocaleString('en-IN') : '-'}</td>
                    <td class="small">${esc(c.vehicleNo || '-')}</td>
                    <td><span class="ch-status-badge ${statusClass}">${formatStatus(c.status)}</span></td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn btn-ghost-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <div class="dropdown-menu dropdown-menu-end ch-action-dropdown">
                                <h6 class="dropdown-header">View</h6>
                                <a class="dropdown-item" href="/Challan/Details?id=${c.challanId}"><i class="bi bi-eye me-2 text-primary"></i>View Details</a>

                                ${!isClosed ? `<div class="dropdown-divider"></div>
                                <h6 class="dropdown-header">Actions</h6>
                                <a class="dropdown-item" href="javascript:void(0)" onclick="openGatePassModal(${c.challanId}, '${esc(c.challanNo)}', '${esc(c.vehicleNo || '')}')">
                                    <i class="bi bi-shield-check me-2 text-success"></i>Issue Gate Pass
                                </a>
                                <a class="dropdown-item" href="javascript:void(0)" onclick="updateStatus(${c.challanId}, 'DISPATCHED', '${esc(c.challanNo)}')">
                                    <i class="bi bi-truck me-2 text-blue"></i>Mark Dispatched
                                </a>
                                <a class="dropdown-item" href="javascript:void(0)" onclick="updateStatus(${c.challanId}, 'DELIVERED', '${esc(c.challanNo)}')">
                                    <i class="bi bi-check-circle me-2 text-success"></i>Mark Delivered
                                </a>` : ''}

                                ${isCreated ? `<div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="javascript:void(0)" onclick="updateStatus(${c.challanId}, 'CANCELLED', '${esc(c.challanNo)}')">
                                    <i class="bi bi-x-circle me-2 text-warning"></i>Cancel
                                </a>
                                <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteChallan(${c.challanId}, '${esc(c.challanNo)}')">
                                    <i class="bi bi-trash me-2"></i>Delete
                                </a>` : ''}
                            </div>
                        </div>
                    </td>
                </tr>`;
            });
            $('#challanListBody').html(html);
        }

        function getStatusClass(status) {
            const map = {
                'CREATED': 'ch-status-created',
                'MATERIAL_ISSUED': 'ch-status-material',
                'MATERIAL_RECEIVED': 'ch-status-material',
                'MATERIAL_RETURNED': 'ch-status-returned',
                'OUTSOURCED_SENT': 'ch-status-outsource',
                'OUTSOURCED_RECEIVED': 'ch-status-outsource',
                'DISPATCHED': 'ch-status-dispatched',
                'DELIVERED': 'ch-status-delivered',
                'CANCELLED': 'ch-status-cancelled',
                'CLOSED': 'ch-status-closed'
            };
            return map[status] || 'bg-secondary-lt';
        }

        function formatStatus(status) {
            if (!status) return 'N/A';
            return status.replace(/_/g, ' ');
        }

        // ── Actions ──
        async function updateStatus(id, status, challanNo) {
            const confirmed = await Swal2.confirmStatus(challanNo, formatStatus(status));
            if (!confirmed) return;
            try {
                await $.ajax({ url: `${CH_API}/updatestatus`, method: 'POST', contentType: 'application/json', data: JSON.stringify({ challanId: id, status }) });
                Swal2.success(`Status updated to ${formatStatus(status)}`);
                loadChallanList();
            } catch (err) { Swal2.error(err.responseJSON?.message || 'Failed to update status'); }
        }

        async function deleteChallan(id, challanNo) {
            const confirmed = await Swal2.confirmDelete(challanNo);
            if (!confirmed) return;
            try {
                Swal2.showLoading('Deleting...');
                await $.ajax({ url: `${CH_API}/delete/${id}`, method: 'DELETE' });
                Swal2.hideLoading();
                Swal2.success('Challan deleted successfully.');
                loadChallanList();
            } catch (err) { Swal2.hideLoading(); Swal2.error(err.responseJSON?.message || 'Failed to delete'); }
        }

        function openGatePassModal(challanId, challanNo, vehicleNo) {
            $('#gpChallanId').val(challanId);
            $('#gpVehicleNo').val(vehicleNo);
            $('#gpPurpose').val(`Delivery against Challan ${challanNo}`);
            $('#gpDriverName').val('');
            $('#gpDriverContact').val('');
            $('#gpRemarks').val('');
            $('#gatePassModal').modal('show');
        }

        async function submitGatePass() {
            const challanId = parseInt($('#gpChallanId').val());
            const payload = {
                challanId,
                vehicleNo: $('#gpVehicleNo').val(),
                driverName: $('#gpDriverName').val(),
                driverContact: $('#gpDriverContact').val(),
                purpose: $('#gpPurpose').val(),
                remarks: $('#gpRemarks').val()
            };
            try {
                Swal2.showLoading('Issuing Gate Pass...');
                const res = await $.ajax({ url: `${CH_API}/issue-gatepass`, method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
                $('#gatePassModal').modal('hide');
                Swal2.hideLoading();
                Swal2.success(res.message || 'Gate Pass issued successfully.');
                loadChallanList();
            } catch (err) { Swal2.hideLoading(); Swal2.error(err.responseJSON?.message || 'Failed to issue gate pass'); }
        }

        function esc(value) {
            return (value || '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
        }
    </script>
}
